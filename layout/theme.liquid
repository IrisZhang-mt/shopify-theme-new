<!doctype html>
{%- liquid
  assign rtl_locales = 'ar,he,fa,ur' | split: ','
  assign locale_dir = 'ltr'
  if rtl_locales contains request.locale.iso_code
    assign locale_dir = 'rtl'
  endif
-%}
<html lang="{{ request.locale.iso_code }}" dir="{{ locale_dir }}" translate="no">
  <head>
    <!-- Pandectes Rules Manual Setup -->
    {% # theme-check-disable ParserBlockingScript %}
    <script src="{{ 'pandectes-rules.js' | file_url }}"></script>
    {% # theme-check-enable ParserBlockingScript %}

    {%- liquid
      case request.page_type
        when 'index'
          assign content_group = 'Home Page'
        when 'collection'
          assign content_group = 'Product List Page'
        when 'product'
          assign content_group = 'Product Detail Page'
        when 'cart'
          assign content_group = 'Cart Page'
        when 'search'
          assign content_group = 'Search Result Page'
        when 'blog'
          assign content_group = 'Blog List Page'
        when 'article'
          assign content_group = 'Blog Detail Page'
        when 'page'
          if page.handle == 'ice-skating-crystals-by-swarovski'
            assign content_group = 'Product List Page'
          else
            case template.suffix
              when 'about-us'
                assign content_group = 'About Us Page'
              when 'contact-us'
                assign content_group = 'Contact Us Page'
              when 'faq'
                assign content_group = 'FAQs Page'
              when 'reviews'
                assign content_group = 'Reviews Page'
              when 'blog'
                assign content_group = 'Blog List Page'
              else
                assign content_group = 'Support & Info Page'
            endcase
          endif
        else
          if request.page_type contains 'customers'
            assign content_group = 'Account Page'
          else
            assign content_group = 'Support & Info Page'
          endif
      endcase

      if customer
        assign login_status = 'log in'
      else
        assign login_status = 'log out'
      endif
    -%}
    <!-- Google Tag Manager -->
    <script>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        {% if customer %}'user_id': "{{ customer.id }}",{% endif %}
        'login_status': {{ login_status | json }},
        'content_group': {{ content_group | json }}
      });
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-N5N9PJ72');
    </script>
    <!-- End Google Tag Manager -->

    {% render 'head-tracking' %}
    {% render 'kiwi-sizing' %}

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google" content="notranslate">
    <meta name="theme-color" content="#fafbf9">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- liquid
      assign og_title = page_title | default: shop.name
      assign og_type = 'website'
      if request.page_type == 'product'
        assign og_type = 'product'
      elsif request.page_type == 'article'
        assign og_type = 'article'
      endif
    -%}
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ og_title | escape }}">
    <meta property="og:type" content="{{ og_type }}">
    {%- if page_description -%}
      <meta property="og:description" content="{{ page_description | escape }}">
    {%- endif -%}
    {%- if page_image -%}
      <meta property="og:image" content="http:{{ page_image | image_url: width: 1200 }}">
      <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
    {%- endif -%}
    {%- if request.page_type == 'product' -%}
      <meta property="og:price:amount" content="{{ product.price | divided_by: 100.0 }}">
      <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ og_title | escape }}">
    {%- if page_description -%}
      <meta name="twitter:description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'structured-data' %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'logo-mark.svg' | asset_url }}">
    {%- endif -%}

    {{ 'fk-grotesk-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'fk-display-regular.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    <style>
      @font-face {
        font-family: 'FK Display';
        src: url('{{ 'fk-display-regular.woff2' | asset_url }}') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'FK Grotesk';
        src: url('{{ 'fk-grotesk-regular.woff2' | asset_url }}') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Geist Mono';
        src: url('{{ 'geist-mono-regular.woff2' | asset_url }}') format('woff2');
        font-weight: 400 500;
        font-style: normal;
        font-display: swap;
      }
    </style>

    <script>
      window.mtStrings = {
        addToCart: {{ 'products.add_to_cart' | t | json }},
        adding: {{ 'products.adding' | t | json }},
        added: {{ 'products.added' | t | json }},
        soldOut: {{ 'products.sold_out' | t | json }},
        unavailable: {{ 'products.unavailable' | t | json }},
        linkCopied: {{ 'article.link_copied' | t | json }},
        showFilters: {{ 'collection.show_filters' | t | json }},
        hideFilters: {{ 'collection.hide_filters' | t | json }},
        shopCollection: {{ 'products.shop_collection' | t: label: '[label]' | json }}
      };
    </script>

    {{ 'index.css' | asset_url | stylesheet_tag }}
    {{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {%- comment -%} Home first screen is only the hero, so cards/swatches load async there; PLP/PDP/search need them above the fold. {%- endcomment -%}
    {%- if request.page_type == 'index' -%}
      <link rel="stylesheet" href="{{ 'product-card.css' | asset_url }}" media="print" onload="this.media='all'">
      <link rel="stylesheet" href="{{ 'color-swatch.css' | asset_url }}" media="print" onload="this.media='all'">
    {%- else -%}
      {{ 'product-card.css' | asset_url | stylesheet_tag }}
      {{ 'color-swatch.css' | asset_url | stylesheet_tag }}
    {%- endif %}
    <link rel="stylesheet" href="{{ 'quick-shop.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'size-chart.css' | asset_url }}" media="print" onload="this.media='all'">
    <script src="{{ 'motion.js' | asset_url }}" type="module"></script>
    <script src="{{ 'product-card.js' | asset_url }}" type="module"></script>
    <script src="{{ 'quick-shop.js' | asset_url }}" type="module"></script>
    <script src="{{ 'size-chart.js' | asset_url }}" type="module"></script>

    {{ content_for_header }}

    <!-- Consent Cookie Cleanup：用户拒绝/撤销授权后清除三方平台 Cookie（Shopify Customer Privacy API） -->
    <script>
    (function () {
      /**
       * 地区判断
       * 说明：可在此处接入你的 GeoIP 逻辑或 Shopify 隐私合规地区检测。
       * 如果当前访客不在受 GDPR/CCPA 等法规约束的地区，直接终止脚本执行。
       */
      function checkRegionAndConsent() {
        // 如果 Shopify 隐私接口返回不需要展示弹窗/不处于受控地区，则直接退出
        // if (window.Shopify && window.Shopify.customerPrivacy) {
        //   if (!window.Shopify.customerPrivacy.shouldShowBanner()) return false;
        // }
        var isInRegulatedRegion = true;
        return isInRegulatedRegion;
      }

      if (!checkRegionAndConsent()) return;

      // 2. Cookie 规则配置
      var cookieRules = {
        preferences: [
          { type: 'contains',   value: 'pref_' }
        ],
        analytics: [
          { type: 'equals',     value: '_ga' },
          { type: 'startsWith', value: '_ga_' },
          { type: 'contains',   value: '_gid' },
          { type: 'endsWith',   value: '_gat' }
        ],
        marketing: [
          { type: 'startsWith', value: '_fbp' },
          { type: 'equals',     value: '_gcl_au' },
          { type: 'contains',   value: 'uetsid' },
          { type: 'endsWith',   value: 'uetvid' }
        ],
        saleOfData: [
          { type: 'contains',   value: 'ccPA_' }
        ]
      };

      function matchRule(cookieName, rule) {
        switch (rule.type) {
          case 'equals':     return cookieName === rule.value;
          case 'contains':   return cookieName.indexOf(rule.value) !== -1;
          case 'startsWith': return cookieName.indexOf(rule.value) === 0;
          case 'endsWith':   return cookieName.slice(-rule.value.length) === rule.value;
          default:           return false;
        }
      }

      function clearCookiesByRules(rules) {
        if (!document.cookie || !rules || !rules.length) return;

        document.cookie.split(';').forEach(function (cookie) {
          var parts = cookie.trim().split('=');
          var name = parts[0];
          if (!name) return;

          if (rules.some(function (rule) { return matchRule(name, rule); })) {
            document.cookie = name + '=; Max-Age=0; path=/;';
            document.cookie = name + '=; Max-Age=0; path=/; domain=' + location.hostname + ';';

            var domainParts = location.hostname.split('.');
            if (domainParts.length > 1) {
              document.cookie = name + '=; Max-Age=0; path=/; domain=.' + domainParts.slice(-2).join('.') + ';';
            }
          }
        });
      }

      function handleConsent(state) {
        if (!state) return;
        if (state.preferencesAllowed === false) clearCookiesByRules(cookieRules.preferences);
        if (state.analyticsAllowed === false)   clearCookiesByRules(cookieRules.analytics);
        if (state.marketingAllowed === false)   clearCookiesByRules(cookieRules.marketing);
        if (state.saleOfDataAllowed === false)  clearCookiesByRules(cookieRules.saleOfData);
      }

      document.addEventListener('visitorConsentCollected', function (event) {
        handleConsent(event.detail);
      });

      if (window.Shopify && typeof window.Shopify.loadFeatures === 'function') {
        window.Shopify.loadFeatures(
          [{ name: 'consent-tracking-api', version: '0.1' }],
          function (error) {
            if (error) return;
            var privacy = window.Shopify.customerPrivacy;
            if (!privacy) return;

            handleConsent({
              preferencesAllowed: privacy.preferencesProcessingAllowed(),
              analyticsAllowed:   privacy.analyticsProcessingAllowed(),
              marketingAllowed:   privacy.marketingAllowed(),
              saleOfDataAllowed:  privacy.saleOfDataAllowed()
            });
          }
        );
      }
    })();
    </script>
    <!-- End Consent Cookie Cleanup -->
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N5N9PJ72"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a class="mt-skip" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>
    <div class="mt-scroll">
      <div class="mt-scroll__inner">
        {% sections 'header-group' %}

        <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
          {{ content_for_layout }}
        </main>

        {% sections 'footer-group' %}
      </div>
    </div>
    {% render 'quick-shop-modal' %}
    {% render 'mkq_script' %}
  </body>
</html>
