{%- assign current = product.selected_or_first_available_variant -%}
{%- assign image_count = 0 -%}
{%- for media in product.media limit: 10 -%}
  {%- if media.media_type == 'image' -%}
    {%- assign image_count = image_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
<div class="mt-qs__panel" data-qs-panel>
  <div class="mt-qs__gallery">
    <div class="mt-qs__track" data-qs-track>
      {%- for media in product.media limit: 10 -%}
        {%- if media.media_type == 'image' -%}
          <div class="mt-qs__slide">
            {%- assign image_alt = media.alt | default: product.title | escape -%}
            {{ media | image_url: width: 950 | image_tag: decoding: 'async', loading: 'lazy', sizes: '(min-width: 750px) 463px, 275px', alt: image_alt }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if image_count > 1 -%}
      <div class="mt-qs__arrows">
        <button class="mt-qs__arrow mt-qs__arrow--prev" type="button" data-qs-prev aria-label="{{ 'products.previous_image' | t }}"><img src="{{ 'arrow.svg' | asset_url }}" width="18" height="12" alt=""></button>
        <button class="mt-qs__arrow" type="button" data-qs-next aria-label="{{ 'products.next_image' | t }}"><img src="{{ 'arrow.svg' | asset_url }}" width="18" height="12" alt=""></button>
      </div>
    {%- endif -%}
    <button class="mt-qs__close mt-qs__close--media" type="button" data-qs-close>{{ 'general.close' | t }}</button>
  </div>
  <div class="mt-qs__info">
    <div class="mt-qs__body">
      <div class="mt-qs__head">
        <h2 class="mt-qs__name">{{ product.title }}</h2>
        <button class="mt-qs__close" type="button" data-qs-close>{{ 'general.close' | t }}</button>
        <p class="mt-qs__price">
          <span data-qs-price>{{ current.price | money_without_trailing_zeros }}</span>
          <s class="mt-qs__compare" data-qs-compare{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{% if current.compare_at_price > current.price %}{{ current.compare_at_price | money_without_trailing_zeros }}{% endif %}</s>
        </p>
      </div>
      {%- if product.has_only_default_variant == false -%}
        {%- for option in product.options_with_values -%}
          {%- if option.name == 'Color' or option.name == 'Colour' -%}
            <div class="mt-qs__option mt-qs__option--color">
              <p class="mt-qs__option-name">{{ option.name }}: <span data-qs-color-name>{{ option.selected_value }}</span></p>
              <div class="mt-qs__swatches">
                {%- assign swatch_colors = product.metafields.custom.color_swatch.value | map: 'color' -%}
                {%- for value in option.values -%}
                  {%- assign swatch_handle = value | handleize -%}
                  {%- assign swatch_entry = shop.metaobjects.color_swatch[swatch_handle] -%}
                  <button class="mt-qs__swatch" type="button" data-qs-value="{{ value | escape }}" data-qs-opt="{{ forloop.parentloop.index0 }}" aria-label="{{ option.name }} {{ value | escape }}" aria-pressed="{% if value.selected %}true{% else %}false{% endif %}"
                    {%- if value.swatch.color %} style="--mt-swatch: rgb({{ value.swatch.color.rgb }})"
                    {%- elsif value.swatch.image %} style="--mt-swatch: url('{{ value.swatch.image | image_url: width: 40 }}')"
                    {%- elsif swatch_entry.color %} style="--mt-swatch: {{ swatch_entry.color }}"
                    {%- elsif swatch_colors[forloop.index0] %} style="--mt-swatch: {{ swatch_colors[forloop.index0] }}"
                    {%- endif %}></button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- assign desc = product.description | strip_html -%}
      {%- if desc != blank -%}
        <p class="mt-qs__desc">{{ desc }}</p>
      {%- endif -%}
      {%- if product.has_only_default_variant == false -%}
        {%- capture other_options -%}
          {%- for option in product.options_with_values -%}
            {%- unless option.name == 'Color' or option.name == 'Colour' -%}
              <div class="mt-qs__option">
                <div class="mt-qs__option-head">
                  <p class="mt-qs__option-name">{{ option.name }}:</p>
                  {%- assign chart_meta = product.metafields.custom.size_chart -%}
                  {%- assign chart_page = chart_meta.value -%}
                  {%- if chart_page.content == blank -%}
                    {%- assign chart_handle = settings.size_chart_url | split: '/pages/' | last | split: '/' | first | split: '?' | first -%}
                    {%- assign chart_page = pages[chart_handle] | default: pages['size-chart'] | default: pages['size-guide'] -%}
                  {%- endif -%}
                  {%- assign chart_url = chart_page.url | default: chart_meta.value | default: settings.size_chart_url -%}
                  {%- if option.name == 'Size' and chart_url != blank -%}
                    <a class="mt-qs__chart" href="{{ chart_url | escape }}"{% if chart_page.content != blank %} data-chart-open="{{ product.id }}"{% endif %}>
                      <img src="{{ 'ruler.svg' | asset_url }}" width="19" height="9" alt="">
                      {{ 'products.size_chart' | t }}
                    </a>
                    {%- if chart_page.content != blank -%}
                      {% render 'size-chart-modal', chart_page: chart_page, chart_id: product.id, chart_name: product.title %}
                    {%- endif -%}
                  {%- endif -%}
                </div>
                <div class="mt-qs__pills">
                  {%- for value in option.values -%}
                    <button class="mt-qs__pill" type="button" data-qs-value="{{ value | escape }}" data-qs-opt="{{ forloop.parentloop.index0 }}" aria-pressed="{% if value.selected %}true{% else %}false{% endif %}">{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endunless -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if other_options contains 'mt-qs__option' -%}
          <div class="mt-qs__variants">{{ other_options }}</div>
        {%- endif -%}
      {%- endif -%}
    </div>
    <div class="mt-qs__ctas">
      <button class="mt-qs__add" type="button" data-qs-add data-qs-variant="{{ current.id }}"{% unless current.available %} disabled{% endunless %}>
        {%- if current.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif -%}
      </button>
      <a class="mt-qs__details" href="{{ product.url }}">{{ 'products.see_details' | t }}</a>
    </div>
  </div>
  <script type="application/json" data-qs-variants>
    [{%- for variant in product.variants -%}{"id":{{ variant.id }},"available":{{ variant.available }},"options":{{ variant.options | json }},"price":{{ variant.price | money_without_trailing_zeros | json }},"compare":{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money_without_trailing_zeros | json }}{% else %}""{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  </script>
</div>

{% schema %}
{
  "name": "Quick shop",
  "settings": []
}
{% endschema %}
