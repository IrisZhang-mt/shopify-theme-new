    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "textarea",
      "id": "miles_text",
      "label": "Loyalty note",
      "default": "Earn moody miles points on this order. Gift cards and promotional codes applied at checkout."
    },
    {
      "type": "text",
      "id": "recs_heading",
      "label": "Recommendations heading",
      "default": "We think you'll love"
    }
  ]
}
