{{ 'product-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-faq.js' | asset_url }}" type="module"></script>

{%- if section.blocks.size > 0 -%}
  <section class="mt-faq{% if section.settings.big_title %} mt-faq--big{% endif %}" data-faq>
    <h2 class="mt-faq__title{% if section.settings.title_align == 'left' %} mt-faq__title--left{% endif %}{% if section.settings.big_title %} mt-faq__title--big{% endif %}" data-reveal>{{ section.settings.heading }}</h2>
    <div class="mt-faq__list" data-reveal>
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          {%- assign open = false -%}
          {%- if forloop.first and section.settings.open_first -%}
            {%- assign open = true -%}
          {%- endif -%}
          <div class="mt-faq__item{% if open %} mt-faq__item--open{% endif %}" data-faq-item {{ block.shopify_attributes }}>
            <button class="mt-faq__q" type="button" data-faq-toggle aria-expanded="{{ open }}" aria-controls="Faq-{{ block.id }}">
              <span>{{ block.settings.question }}</span>
              <img src="{{ 'plus.svg' | asset_url }}" width="12" height="12" alt="" aria-hidden="true">
            </button>
            <div class="mt-faq__panel" id="Faq-{{ block.id }}" role="region">
              <div class="mt-faq__a">{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first question",
      "default": false
    },
    {
      "type": "select",
      "id": "title_align",
      "label": "Title alignment",
      "options": [
        { "value": "middle", "label": "Middle" },
        { "value": "left", "label": "Left" }
      ],
      "default": "middle"
    },
    {
      "type": "checkbox",
      "id": "big_title",
      "label": "Large title",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
