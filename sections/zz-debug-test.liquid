{%- assign test_keys = 'rose quartz' | split: ',' -%}
{%- assign test_values = 'rose-quartz.png' | split: ',' -%}
{%- assign empty_arr = '' | split: ',' -%}
<div>
  {%- capture swatch_value_a -%}{%- render 'color-swatch', value: 'Rose Quartz', index: 0, swatch_colors: blank, swatch_images: blank, custom_color_keys: test_keys, custom_color_values: test_values -%}{%- endcapture -%}
  A=[{{ swatch_value_a }}]
  {%- capture swatch_value_b -%}{%- render 'color-swatch', value: 'Rose Quartz', index: 0, swatch_colors: empty_arr, swatch_images: empty_arr, custom_color_keys: test_keys, custom_color_values: test_values -%}{%- endcapture -%}
  B=[{{ swatch_value_b }}]
  {%- capture swatch_value_c -%}{{- 'rose-quartz.png' | file_url | prepend: "url('" | append: "')" -}}{%- endcapture -%}
  C=[{{ swatch_value_c }}]
  {%- capture trivial_d -%}{%- render 'zz-trivial' -%}{%- endcapture -%}
  D=[{{ trivial_d }}]
  E=[{% render 'zz-trivial' %}]
  {%- capture trivial_f -%}{%- render 'zz-trivial2' -%}{%- endcapture -%}
  F=[{{ trivial_f }}]
</div>
{% schema %}
{
  "name": "zz debug test",
  "settings": []
}
{% endschema %}
