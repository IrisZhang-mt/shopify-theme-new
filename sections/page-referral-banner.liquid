{{ 'page-referral-banner.css' | asset_url | stylesheet_tag }}

<section class="mt-referral">
  <div class="mt-referral__inner{% if section.settings.subtext == blank %} mt-referral__inner--no-sub{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="mt-referral__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="mt-referral__sub">{{ section.settings.subtext | newline_to_br }}</p>
    {%- endif -%}

    {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
      <a class="mt-referral__cta" href="{{ section.settings.cta_url | default: '#' }}">
        <span>{{ section.settings.cta_label }}</span>
      </a>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mt-referral__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'item' -%}
            <div class="mt-referral__list-item" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="mt-referral__list-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="mt-referral__list-subtitle">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Referral banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Give 15%, Get 15%."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "info": "Use a line break to control where the text wraps.",
      "default": "Give friends 15% off their first order, and\nget a 15% off coupon for every referral."
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show button",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Refer now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "We take responsibility for our impact."
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "A responsibly acting party of the textile supply chain."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Referral banner"
    }
  ]
}
{% endschema %}
