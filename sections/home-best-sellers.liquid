{{ 'home-best-sellers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home-best-sellers.js' | asset_url }}" type="module"></script>

{%- assign first_block = section.blocks.first -%}

<section class="mt-bs">
  <div class="mt-bs__intro">
    <div class="mt-bs__lead">
      {%- if section.settings.heading != blank -%}
        <h2 class="mt-bs__title" data-reveal>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="mt-bs__filters" data-reveal style="--mt-reveal-i: 1">
          {%- for block in section.blocks -%}
            <button
              class="mt-bs__filter"
              type="button"
              data-bs-target="{{ forloop.index0 }}"
              data-bs-url="{{ block.settings.collection.url | default: '#' }}"
              data-bs-label="{{ block.settings.label | escape }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="mt-bs__dot"></span>{{ block.settings.label }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- if first_block -%}
      <a class="mt-bs__cta" data-bs-cta href="{{ first_block.settings.collection.url | default: '#' }}" data-reveal style="--mt-reveal-i: 2">
        <span class="mt-bs__dot mt-bs__dot--ink"></span>
        <span data-bs-cta-text>{{ 'products.shop_collection' | t: label: first_block.settings.label }}</span>
      </a>
    {%- endif -%}
  </div>

  <div class="mt-bs__stage" data-row-stage>
    <div class="mt-bs__row" data-bs-row data-autoplay="30" data-wheel-lock>
      {% render 'product-card-list', collection: first_block.settings.collection %}
    </div>
    <button class="mt-row-nav mt-row-nav--prev" type="button" data-row-arrow="prev" aria-label="{{ 'general.previous' | t }}">
      <img src="{{ 'arrow.svg' | asset_url }}" width="18" height="12" alt="">
    </button>
    <button class="mt-row-nav mt-row-nav--next" type="button" data-row-arrow="next" aria-label="{{ 'general.next' | t }}">
      <img src="{{ 'arrow.svg' | asset_url }}" width="18" height="12" alt="">
    </button>
  </div>
  {%- for block in section.blocks offset: 1 -%}
    <template data-bs-panel="{{ forloop.index }}">
      {% render 'product-card-list', collection: block.settings.collection %}
    </template>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Best sellers",
  "class": "section-best-sellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Girls"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Best sellers",
      "blocks": [
        {
          "type": "collection",
          "settings": { "label": "Girls" }
        },
        {
          "type": "collection",
          "settings": { "label": "Boys" }
        }
      ]
    }
  ]
}
{% endschema %}
