{%- if request.page_type == 'index' -%}
  {%- comment -%} theme.liquid loads card/swatch CSS async on home; load it here, ahead of the cards, so a fast scroll on a slow network never shows unstyled cards. {%- endcomment -%}
  {{ 'product-card.css' | asset_url | stylesheet_tag }}
  {{ 'color-swatch.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{{ 'product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-grid.js' | asset_url }}" type="module"></script>

{%- liquid
  assign pg_collection = section.settings.collection
  assign pg_item_list_id = pg_collection.handle
  assign pg_item_list_name = section.settings.heading | default: pg_collection.title
  assign pg_sizes = '(min-width: 750px) calc((94vw - 27px) / 4), calc((100vw - 37px) / 2)'
  assign has_products = false
  if pg_collection.products_count > 0
    assign has_products = true
  endif
-%}

{%- if has_products or pg_collection == blank -%}
  <section
    class="mt-pgrid"
    {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handleize }}"{% endif %}
    data-pgrid
    data-currency="{{ cart.currency.iso_code }}"
  >
    <div class="mt-pgrid__inner">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="mt-pgrid__intro">
          {%- if section.settings.heading != blank -%}
            <h2 class="mt-pgrid__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <ul class="mt-pgrid__tags" role="list">
              {%- assign pg_tags = section.settings.subheading | split: '|' -%}
              {%- for tag in pg_tags -%}
                {%- assign tag_text = tag | strip -%}
                {%- if tag_text != blank -%}
                  <li class="mt-pgrid__tag">{{ tag_text | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if has_products -%}
        {%- paginate pg_collection.products by section.settings.count -%}
          <div class="mt-pgrid__grid" data-pgrid-grid>
            {%- for item in pg_collection.products -%}
              {%- assign pg_ga4_index = paginate.current_offset | plus: forloop.index0 -%}
              {% render 'product-card',
                product: item,
                index: forloop.index0,
                ga4_index: pg_ga4_index,
                sizes: pg_sizes,
                quick: true,
                sale_badge: true,
                hide_swatches: true,
                item_list_id: pg_item_list_id,
                item_list_name: pg_item_list_name
              %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            {%- liquid
              assign pg_from = paginate.current_offset | plus: 1
              assign pg_to = paginate.current_offset | plus: paginate.page_size | at_most: paginate.items
              assign pg_count_template = 'collection.showing' | t: from: '[from]', to: '[to]', total: '[total]'
              assign pg_page_label = 'general.page_n' | t: number: '[n]'
            -%}
            {%- comment -%} Page buttons are rendered by product-grid.js (in-place swap, no URL change). {%- endcomment -%}
            <nav
              class="mt-pgrid__pager"
              aria-label="{{ 'general.pagination' | t }}"
              data-pgrid-pager
              data-page="{{ paginate.current_page }}"
              data-pages="{{ paginate.pages }}"
              data-total="{{ paginate.items }}"
              data-per-page="{{ paginate.page_size }}"
              data-template="{{ pg_count_template | escape }}"
              data-label-page="{{ pg_page_label | escape }}"
              data-label-prev="{{ 'general.previous' | t | escape }}"
              data-label-next="{{ 'general.next' | t | escape }}"
            >
              <p class="mt-pgrid__count" aria-live="polite" data-pgrid-count>
                {{- 'collection.showing' | t: from: pg_from, to: pg_to, total: paginate.items -}}
              </p>
              <div class="mt-pgrid__pages" data-pgrid-pages></div>
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="mt-pgrid__grid" data-pgrid-grid>
          {%- for i in (1..4) -%}
            {% render 'product-card', product: blank, index: forloop.index0 %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "按该系列在后台设置的排序分页展示全部商品"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products per page",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "info": "超过一页时在列表下方显示翻页"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitle",
      "info": "展示在标题右侧的橙色标签，多个标签用 | 分隔，例如 BUY 4+: 20% OFF | BUY 6+: 30% OFF；留空时不展示"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID (optional)",
      "info": "供 Anchor tabs 跳转定位，例如 new-arrivals；需与 tab 的 Target ID 一致，同一页面内不要重复"
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ]
}
{% endschema %}
