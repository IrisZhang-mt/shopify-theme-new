{{ 'product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-grid.js' | asset_url }}" type="module"></script>

{%- liquid
  assign pg_collection = section.settings.collection
  assign pg_new_handle = section.settings.new_collection.handle
  assign pg_item_list_id = pg_collection.handle
  assign pg_item_list_name = section.settings.heading | default: pg_collection.title
  assign pg_sizes = '(min-width: 1644px) 383px, (min-width: 750px) calc((100vw - 111px) / 4), calc((100vw - 37px) / 2)'
  assign has_products = false
  if pg_collection.products.size > 0
    assign has_products = true
  endif
-%}

{%- if has_products or pg_collection == blank -%}
  <section class="mt-pgrid" data-pgrid data-currency="{{ cart.currency.iso_code }}">
    <div class="mt-pgrid__inner">
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="mt-pgrid__intro">
          {%- if section.settings.heading != blank -%}
            <h2 class="mt-pgrid__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="mt-pgrid__sub">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="mt-pgrid__grid" data-pgrid-grid>
        {%- if has_products -%}
          {%- for item in pg_collection.products limit: section.settings.count -%}
            {% render 'product-card',
              product: item,
              index: forloop.index0,
              sizes: pg_sizes,
              quick: true,
              auto_badges: true,
              new_handle: pg_new_handle,
              hide_swatches: true,
              item_list_id: pg_item_list_id,
              item_list_name: pg_item_list_name
            %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            {% render 'product-card', product: blank, index: forloop.index0 %}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.cta_label != blank and pg_collection != blank -%}
        <a class="mt-pgrid__cta" href="{{ pg_collection.url }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "按该系列在后台设置的排序，取前 N 个商品；SHOP MORE 跳转到该系列"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products shown",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitle",
      "info": "展示在标题右侧的灰色小字，例如 10% OFF；留空时不展示"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop more",
      "info": "留空时不展示按钮"
    },
    {
      "type": "collection",
      "id": "new_collection",
      "label": "NEW badge collection",
      "info": "属于该系列的商品显示 NEW 角标，例如 New Arrivals；有划线价的商品自动显示 SALE 角标"
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ]
}
{% endschema %}
