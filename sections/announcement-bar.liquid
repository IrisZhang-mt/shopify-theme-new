{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'announcement-bar.js' | asset_url }}" type="module"></script>

{%- assign messages = section.blocks | where: 'type', 'message' -%}

{%- if section.blocks.size > 0 -%}
  <div
    class="mt-announce mt-announce--{{ section.settings.scheme }}"
    data-announce
    data-announce-every="{{ section.settings.rotate }}"
  >
    <div class="mt-announce__inner">
      {%- if messages.size > 0 -%}
        <div class="mt-announce__stack">
          {%- for block in messages -%}
            <div
              class="mt-announce__slide{% if forloop.first %} mt-on{% endif %}"
              data-announce-slide
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.link != blank -%}
                <a class="mt-announce__text mt-announce__text--link" href="{{ block.settings.link | escape }}"{% unless forloop.first %} tabindex="-1"{% endunless %}>{{ block.settings.text }}</a>
              {%- else -%}
                <p class="mt-announce__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="mt-announce__app" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announce",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour",
      "options": [
        { "value": "accent", "label": "Tangerine" },
        { "value": "ink", "label": "Midnight" },
        { "value": "lime", "label": "Lime" },
        { "value": "sand", "label": "Sand" },
        { "value": "paper", "label": "Paper" }
      ],
      "default": "accent"
    },
    {
      "type": "range",
      "id": "rotate",
      "label": "Seconds per message",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "Applies when more than one message block is added."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over $100"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
