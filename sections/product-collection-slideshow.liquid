{%- liquid
  assign source_collection = product.collections.first
  assign pc_images = blank
  assign mob_images = blank
  if source_collection
    assign pc_images = source_collection.metafields.custom.collection_slideshow_pc.value
    assign mob_images = source_collection.metafields.custom.collection_slideshow_mob.value
  endif

  assign slide_count = pc_images.size
  if mob_images.size > slide_count
    assign slide_count = mob_images.size
  endif
-%}

{%- if slide_count > 0 -%}
  {{ 'slideshow.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'slideshow.js' | asset_url }}" type="module"></script>

  {%- liquid
    assign last_index = slide_count | minus: 1
    assign autoplay = section.settings.autoplay
    assign interval = section.settings.autoplay_interval | default: 5
    assign module_name = section.settings.analytics_label | default: 'Collection slideshow'
    assign show_dots = false
    if slide_count > 1
      assign show_dots = true
    endif
  -%}

  <section
    class="mt-slideshow"
    data-slideshow
    data-slideshow-autoplay="{{ autoplay }}"
    data-slideshow-interval="{{ interval }}"
    data-slideshow-module="{{ module_name | escape }}"
  >
    {%- for i in (0..last_index) -%}
      {%- liquid
        assign pc_image = pc_images[i]
        assign mob_image = mob_images[i] | default: pc_image
        assign pc_image = pc_image | default: mob_image
        assign eager = false
        if forloop.first
          assign eager = true
        endif
        assign image_alt = pc_image.alt | default: mob_image.alt | default: source_collection.title | strip_newlines | escape
      -%}
      {%- if pc_image != blank or mob_image != blank -%}
        <div
          class="mt-slideshow__slide{% if forloop.first %} mt-slideshow__slide--active{% endif %}"
          data-slideshow-slide
          data-banner-slot="{{ forloop.index }}"
          data-banner-name="{{ source_collection.title | escape }}"
        >
          <div class="mt-slideshow__media">
            <picture>
              {%- if pc_image != blank and pc_image != mob_image -%}
                <source media="(min-width: 750px)" srcset="{{ pc_image | image_url: width: 750 }} 750w, {{ pc_image | image_url: width: 1500 }} 1500w, {{ pc_image | image_url: width: 2200 }} 2200w">
              {%- endif -%}
              {%- if eager -%}
                {{ mob_image | image_url: width: 1200 | image_tag: decoding: 'async', loading: 'eager', fetchpriority: 'high', sizes: '100vw', alt: image_alt }}
              {%- else -%}
                {{ mob_image | image_url: width: 1200 | image_tag: decoding: 'async', loading: 'lazy', sizes: '100vw', alt: image_alt }}
              {%- endif -%}
            </picture>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if show_dots -%}
      <div class="mt-slideshow__dots" aria-label="{{ 'general.slides' | t }}">
        {%- for i in (1..slide_count) -%}
          <button
            class="mt-slideshow__dot"
            type="button"
            data-slideshow-dot
            aria-label="{{ 'general.slide_n' | t: number: i }}"
            aria-current="{{ forloop.first }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collection slideshow",
  "class": "section-product-collection-slideshow",
  "settings": [
    {
      "type": "paragraph",
      "content": "Images come from the product's first collection, via the collection metafields collection_slideshow_pc and collection_slideshow_mob (custom namespace). The section renders nothing if the collection has no images set."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "info": "Only applies when there's more than one slide.",
      "default": 5
    },
    {
      "type": "text",
      "id": "analytics_label",
      "label": "Analytics label",
      "info": "Identifies this slideshow in analytics reports if you use more than one on the site.",
      "default": "Collection slideshow"
    }
  ],
  "presets": [
    {
      "name": "Collection slideshow"
    }
  ]
}
{% endschema %}
