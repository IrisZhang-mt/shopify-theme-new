{{ 'plp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'plp.js' | asset_url }}" type="module"></script>

{%- paginate collection.products by section.settings.products_per_page -%}
  {%- assign plp_item_list_id = collection.handle -%}
  {%- assign plp_item_list_name = collection.title -%}
  <div class="mt-plp" data-plp data-url="{{ collection.url }}" data-currency="{{ cart.currency.iso_code }}" data-item-list-id="{{ plp_item_list_id }}" data-item-list-name="{{ plp_item_list_name | escape }}">
    <div class="mt-plp__title">
      <h1 tabindex="-1" data-plp-heading>{{ collection.title }}</h1>
    </div>

    {%- assign linked = collection.metafields.custom.category_tiles.value -%}
    {%- if linked != blank and linked.size > 0 -%}
      <div class="mt-plp__tiles">
        {%- for entry in linked -%}
          {%- assign tile_image = entry.image | default: entry.featured_image -%}
          <a class="mt-plp__tile" href="{{ entry.url }}" data-reveal style="--mt-reveal-i: {{ forloop.index0 }}" data-category-name="{{ entry.title | escape }}">
            {%- if tile_image != blank -%}
              {{ tile_image | image_url: width: 1000 | image_tag: decoding: 'async', loading: 'eager', sizes: '(min-width: 750px) 33vw, 30vw', alt: entry.title | escape }}
            {%- endif -%}
            <span class="mt-plp__tile-label">{{ entry.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- elsif section.blocks.size > 0 -%}
      <div class="mt-plp__tiles">
        {%- for block in section.blocks -%}
          <a class="mt-plp__tile"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %} data-reveal style="--mt-reveal-i: {{ forloop.index0 }}" data-category-name="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: decoding: 'async', loading: 'eager', sizes: '(min-width: 750px) 33vw, 30vw', alt: block.settings.label | escape }}
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <span class="mt-plp__tile-label">{{ block.settings.label }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="mt-plp__bar">
      <button class="mt-plp__toggle" type="button" aria-expanded="true" data-plp-toggle>{{ 'collection.hide_filters' | t }}</button>
      <p class="mt-plp__count" role="status">{{ 'collection.products_count' | t: count: collection.products_count }}</p>
    </div>

    <div class="mt-plp__content">
      <aside class="mt-plp__aside" data-plp-aside>
        {%- assign custom_color_keys = '' -%}
        {%- assign custom_color_values = '' -%}
        {%- if settings.color_swatches != blank -%}
          {%- assign custom_color_lines = settings.color_swatches | newline_to_br | split: '<br />' -%}
          {%- for line in custom_color_lines -%}
            {%- assign custom_color_key = line | split: ':' | first | rstrip -%}
            {%- assign custom_color_value = line | split: ':' | last | lstrip -%}
            {%- assign custom_color_keys = custom_color_keys | append: ',' | append: custom_color_key -%}
            {%- assign custom_color_values = custom_color_values | append: ',' | append: custom_color_value -%}
          {%- endfor -%}
          {%- assign custom_color_keys = custom_color_keys | remove_first: ',' | strip_newlines | downcase | split: ',' -%}
          {%- assign custom_color_values = custom_color_values | remove_first: ',' | split: ',' -%}
        {%- endif -%}
        <form class="mt-plp__filters" data-plp-filters>
          <div class="mt-plp__filters-bar">
            <button class="mt-plp__filters-close" type="button" data-plp-close>{{ 'collection.hide_filters' | t }}</button>
            <p>{{ 'collection.products_count' | t: count: collection.products_count }}</p>
          </div>
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'list' or filter.type == 'boolean' -%}
              <details class="mt-plp__group" data-plp-group="{{ filter.param_name }}" data-filter-type="{{ filter.label | escape }}">
                <summary class="mt-plp__group-head">
                  <span>{{ filter.label }}</span>
                  <span class="mt-plp__group-icon" aria-hidden="true"></span>
                </summary>
                {%- assign is_color = false -%}
                {%- assign param_down = filter.param_name | downcase -%}
                {%- if param_down contains 'color' or param_down contains 'colour' -%}
                  {%- assign is_color = true -%}
                {%- endif -%}
                <div class="mt-plp__options{% if is_color %} mt-plp__options--swatches{% endif %}">
                  {%- for value in filter.values -%}
                    <label class="mt-plp__option{% if value.count == 0 and value.active == false %} mt-plp__option--off{% endif %}"{% if is_color %} title="{{ value.label | escape }}"{% endif %}>
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" data-filter-content="{{ value.label | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                      {%- if is_color -%}
                        {%- capture filter_swatch_value -%}{%- render 'color-swatch', value: value.label, custom_color_keys: custom_color_keys, custom_color_values: custom_color_values -%}{%- endcapture -%}
                        <span class="mt-plp__swatch" style="--mt-swatch: {{ filter_swatch_value }}"></span>
                      {%- else -%}
                        <span class="mt-check"></span>
                      {%- endif -%}
                      <span class="mt-plp__option-label{% if is_color %} visually-hidden{% endif %}">{{ value.label }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
          <div class="mt-plp__actions">
            <button class="mt-plp__clear" type="button" data-plp-clear>{{ 'collection.clear_all' | t }}</button>
            <button class="mt-plp__apply" type="submit">{{ 'collection.apply_filters' | t }}</button>
          </div>
        </form>
      </aside>

      <div class="mt-plp__main">
        {%- if collection.products.size > 0 -%}
          <div class="mt-plp__grid{% if section.settings.single_line_titles %} mt-plp__grid--one-line{% endif %}" data-plp-grid data-title-grid>
            {%- for product in collection.products -%}
              {%- assign card_index = forloop.index0 | modulo: 4 -%}
              {%- assign card_eager = false -%}
              {%- if forloop.index0 < 4 -%}
                {%- assign card_eager = true -%}
              {%- endif -%}
              {% render 'product-card', product: product, quick: true, align: true, index: card_index, ga4_index: forloop.index0, eager: card_eager, sizes: '(min-width: 750px) 25vw, 46vw', item_list_id: plp_item_list_id, item_list_name: plp_item_list_name %}
            {%- endfor -%}
          </div>
          {%- assign viewing_template = 'collection.viewing' | t: shown: '[shown]', total: paginate.items -%}
          <div class="mt-plp__more" data-plp-more{% if paginate.next %} data-next-url="{{ paginate.next.url }}"{% endif %}>
            <p class="mt-plp__viewing" role="status" data-plp-viewing data-template="{{ viewing_template | escape }}">{{ 'collection.viewing' | t: shown: collection.products.size, total: paginate.items }}</p>
            {%- if paginate.next -%}
              <button class="mt-plp__more-btn" type="button" data-plp-more-btn>{{ 'collection.view_more' | t }}</button>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="mt-plp__empty">
            <p>{{ 'collection.empty' | t }}</p>
            <button class="mt-plp__clear-link" type="button" data-plp-clear>{{ 'collection.clear_all_link' | t }}</button>
          </div>
        {%- endif -%}

        <div class="mt-plp__top-rail">
          <button class="mt-plp__top" type="button" aria-label="{{ 'collection.back_to_top' | t }}" data-plp-top>
            <svg width="12" height="14" viewBox="0 0 12 14" fill="none" aria-hidden="true" focusable="false"><path d="M6 14V1.5M1 6.5l5-5 5 5" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per load",
      "info": "Products shown first and added by each \"View more\". Must be a multiple of 4 so every row is full (4 per row on desktop, 2 on mobile).",
      "min": 4,
      "max": 100,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "single_line_titles",
      "label": "Single-line product titles",
      "info": "Truncates long titles with an ellipsis so every card keeps one title line.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
