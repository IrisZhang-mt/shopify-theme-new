{{ 'pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pdp.js' | asset_url }}" type="module"></script>

{%- assign current = product.selected_or_first_available_variant -%}
{%- capture pdp_ga4_variant -%}{% render 'item-variant-ga4', item: current %}{%- endcapture -%}
{%- assign pdp_ga4_variant = pdp_ga4_variant | strip -%}

{%- assign color_index = -1 -%}
{%- for option in product.options_with_values -%}
  {%- if option.name == 'Color' or option.name == 'Colour' -%}
    {%- assign color_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- assign current_color = '' -%}
{%- if color_index >= 0 -%}
  {%- assign current_color = current.options[color_index] -%}
{%- endif -%}

<section
  class="mt-pdp"
  data-pdp
  data-currency="{{ cart.currency.iso_code }}"
  data-item-name="{{ product.title | escape }}"
  data-item-brand="{{ product.vendor | escape }}"
  {% if product.type != blank %}data-item-category="{{ product.type | escape }}"{% endif %}
  {% if color_index >= 0 %} data-pdp-color-opt="{{ color_index }}"{% endif %}
  {% if product.selected_variant == nil and product.metafields.custom.default_color != blank %} data-pdp-default-color="{{ product.metafields.custom.default_color | escape }}"{% endif %}
>
  <script>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event_parameters: null });
    window.dataLayer.push({
      event: 'ga4Event',
      event_name: 'view_item',
      event_parameters: {
        currency: {{ cart.currency.iso_code | json }},
        value: {{ current.price | divided_by: 100.0 }},
        items: [
          {
            item_id: {{ current.sku | json }},
            item_name: {{ product.title | json }},
            discount: {% if current.compare_at_price > current.price %}{{ current.compare_at_price | minus: current.price | divided_by: 100.0 }}{% else %}0{% endif %},
            {%- if product.type != blank %}
            item_category: {{ product.type | json }},
            {%- endif %}
            {%- if pdp_ga4_variant != blank %}
            item_variant: {{ pdp_ga4_variant | json }},
            {%- endif %}
            item_brand: {{ product.vendor | json }},
            price: {{ current.price | divided_by: 100.0 }},
            quantity: 1
          }
        ]
      }
    });
  </script>
  <div class="mt-pdp__hero">
    <div class="mt-pdp__gallery" data-pdp-col>
      <div class="mt-pdp__track" data-pdp-track>
        {%- assign image_count = 0 -%}
        {%- assign shown_count = 0 -%}
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            {%- assign image_count = image_count | plus: 1 -%}
            {%- assign media_color = '' -%}
            {%- assign alt_text = media.alt | default: '' -%}
            {%- if color_index >= 0 and alt_text contains '**' -%}
              {%- assign alt_marker_parts = alt_text | split: '**' -%}
              {%- if alt_marker_parts.size >= 2 -%}
                {%- assign media_color = alt_marker_parts[1] | strip -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign hide_slide = false -%}
            {%- if media_color != blank and current_color != blank -%}
              {%- assign media_color_cmp = media_color | downcase -%}
              {%- assign current_color_cmp = current_color | downcase -%}
              {%- if media_color_cmp != current_color_cmp -%}
                {%- assign hide_slide = true -%}
              {%- endif -%}
            {%- endif -%}
            {%- unless hide_slide -%}
              {%- assign shown_count = shown_count | plus: 1 -%}
            {%- endunless -%}
            <div class="mt-pdp__slide{% if media_color == blank %} mt-pdp__slide--shared{% endif %}" data-pdp-media="{{ media.position }}" data-pdp-color="{{ media_color | escape }}"{% if hide_slide %} hidden{% endif %}>
              {%- assign image_alt = media.alt | default: product.title | escape -%}
              {%- if hide_slide == false and shown_count <= 2 -%}
                {{ media | image_url: width: 1100 | image_tag: decoding: 'async', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 28vw, 74vw', alt: image_alt }}
              {%- else -%}
                {{ media | image_url: width: 1100 | image_tag: decoding: 'async', loading: 'lazy', sizes: '(min-width: 750px) 28vw, 74vw', alt: image_alt }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if image_count == 0 -%}
          <div class="mt-pdp__slide"></div>
        {%- endif -%}
      </div>
      {%- if image_count > 1 -%}
        <div class="mt-pdp__arrows">
          <button class="mt-pdp__arrow mt-pdp__arrow--prev" type="button" data-pdp-prev aria-label="{{ 'products.previous_image' | t }}" disabled><img src="{{ 'arrow.svg' | asset_url }}" width="18" height="12" alt=""></button>
          <button class="mt-pdp__arrow" type="button" data-pdp-next aria-label="{{ 'products.next_image' | t }}"><img src="{{ 'arrow.svg' | asset_url }}" width="18" height="12" alt=""></button>
        </div>
      {%- endif -%}
    </div>

    <div class="mt-pdp__right" data-pdp-col>
      <div class="mt-pdp__upper">
        <div class="mt-pdp__content">
          <div class="mt-pdp__info" data-reveal>
            <div class="mt-pdp__head">
              <h1 class="mt-pdp__title">{{ product.title }}</h1>
              <p class="mt-pdp__price">
                <span data-pdp-price>{{ current.price | money_without_trailing_zeros }}</span>
                <s class="mt-pdp__compare" data-pdp-compare{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{% if current.compare_at_price > current.price %}{{ current.compare_at_price | money_without_trailing_zeros }}{% endif %}</s>
              </p>
            </div>
            <p class="mt-pdp__sku" data-pdp-sku{% if current.sku == blank %} hidden{% endif %}>{{ 'products.sku' | t }}: <span data-pdp-sku-value>{{ current.sku }}</span></p>
            {%- assign features = product.metafields.custom.features.value -%}
            {%- if features -%}
              <div class="mt-pdp__tags">
                {%- for feature in features limit: 6 -%}
                  <span class="mt-pdp__tag">{{ feature }}</span>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          {%- if product.has_only_default_variant == false -%}
            <div class="mt-pdp__options" data-reveal style="--mt-reveal-i: 1">
              {%- for option in product.options_with_values -%}
                {%- if option.name == 'Color' or option.name == 'Colour' -%}
                  <div class="mt-pdp__option">
                    <p class="mt-pdp__label" aria-live="polite">{{ option.name }}: <span>{{ option.selected_value }}</span></p>
                    <div class="mt-pdp__tiles" data-pdp-tiles>
                      {%- assign swatch_colors = product.metafields.custom.color_swatch.value | map: 'color' -%}
                      {%- assign swatch_images = product.metafields.custom.color_swatch.value | map: 'image' -%}
                      {%- assign custom_color_keys = '' -%}
                      {%- assign custom_color_values = '' -%}
                      {%- if settings.color_swatches != blank -%}
                        {%- assign custom_color_lines = settings.color_swatches | newline_to_br | split: '<br />' -%}
                        {%- for line in custom_color_lines -%}
                          {%- assign custom_color_key = line | split: ':' | first | rstrip -%}
                          {%- assign custom_color_value = line | split: ':' | last | lstrip -%}
                          {%- assign custom_color_keys = custom_color_keys | append: ',' | append: custom_color_key -%}
                          {%- assign custom_color_values = custom_color_values | append: ',' | append: custom_color_value -%}
                        {%- endfor -%}
                        {%- assign custom_color_keys = custom_color_keys | remove_first: ',' | strip_newlines | downcase | split: ',' -%}
                        {%- assign custom_color_values = custom_color_values | remove_first: ',' | split: ',' -%}
                      {%- endif -%}
                      {%- for value in option.values -%}
                        {%- assign swatch_handle = value | handleize -%}
                        {%- assign swatch_entry = shop.metaobjects.color_swatch[swatch_handle] -%}
                        {%- assign custom_color_lookup = value | downcase | escape -%}
                        {%- assign custom_color_value = '' -%}
                        {%- for key in custom_color_keys -%}
                          {%- if key == custom_color_lookup -%}
                            {%- assign custom_color_value = custom_color_values[forloop.index0] -%}
                          {%- endif -%}
                        {%- endfor -%}
                        <button class="mt-pdp__tile" type="button" data-pdp-value="{{ value | escape }}" data-pdp-opt="{{ forloop.parentloop.index0 }}" aria-label="{{ option.name }} {{ value | escape }}" aria-pressed="{% if value.selected %}true{% else %}false{% endif %}">
                          {%- if swatch_images[forloop.index0] -%}
                            {{ swatch_images[forloop.index0] | image_url: width: 210 | image_tag: decoding: 'async', loading: 'lazy', widths: '70, 140, 210', sizes: '70px', alt: value | escape }}
                          {%- elsif swatch_entry.image -%}
                            {{ swatch_entry.image | image_url: width: 210 | image_tag: decoding: 'async', loading: 'lazy', widths: '70, 140, 210', sizes: '70px', alt: value | escape }}
                          {%- elsif value.variant.featured_media -%}
                            {{ value.variant.featured_media | image_url: width: 210 | image_tag: decoding: 'async', loading: 'lazy', widths: '70, 140, 210', sizes: '70px', alt: value | escape }}
                          {%- elsif value.swatch.color -%}
                            <span class="mt-pdp__tile-fill" style="--mt-swatch: rgb({{ value.swatch.color.rgb }})"></span>
                          {%- elsif value.swatch.image -%}
                            <span class="mt-pdp__tile-fill" style="--mt-swatch: url('{{ value.swatch.image | image_url: width: 140 }}')"></span>
                          {%- elsif swatch_entry.color -%}
                            <span class="mt-pdp__tile-fill" style="--mt-swatch: {{ swatch_entry.color }}"></span>
                          {%- elsif swatch_colors[forloop.index0] -%}
                            <span class="mt-pdp__tile-fill" style="--mt-swatch: {{ swatch_colors[forloop.index0] }}"></span>
                          {%- elsif custom_color_value contains '.' -%}
                            <span class="mt-pdp__tile-fill" style="--mt-swatch: url('{{ custom_color_value | file_url }}')"></span>
                          {%- elsif custom_color_value != blank -%}
                            <span class="mt-pdp__tile-fill" style="--mt-swatch: {{ custom_color_value }}"></span>
                          {%- endif -%}
                        </button>
                      {%- endfor -%}
                    </div>
                    <button class="mt-pdp__tiles-toggle" type="button" data-pdp-tiles-toggle hidden aria-expanded="false">
                      <span data-pdp-tiles-more>{{ 'products.show_all_colors' | t }}</span>
                      <span data-pdp-tiles-less hidden>{{ 'products.show_fewer_colors' | t }}</span>
                    </button>
                  </div>
                {%- else -%}
                  <div class="mt-pdp__option">
                    <div class="mt-pdp__option-head">
                      <p class="mt-pdp__label" aria-live="polite">{{ option.name }}: <span>{{ option.selected_value }}</span></p>
                      {%- assign chart_meta = product.metafields.custom.size_chart -%}
                      {%- assign chart_page = chart_meta.value -%}
                      {%- if chart_page.content == blank -%}
                        {%- assign chart_handle = settings.size_chart_url | split: '/pages/' | last | split: '/' | first | split: '?' | first -%}
                        {%- assign chart_page = pages[chart_handle] | default: pages['size-chart'] | default: pages['size-guide'] -%}
                      {%- endif -%}
                      {%- assign chart_url = chart_page.url | default: chart_meta.value | default: settings.size_chart_url -%}
                      {%- if option.name == 'Size' and chart_url != blank -%}
                        <a class="mt-pdp__chart" href="{{ chart_url | escape }}"{% if chart_page.content != blank %} data-chart-open="{{ product.id }}"{% endif %}>
                          <img src="{{ 'ruler.svg' | asset_url }}" width="19" height="9" alt="">
                          {{ 'products.size_chart' | t }}
                        </a>
                        {%- if chart_page.content != blank -%}
                          {% render 'size-chart-modal', chart_page: chart_page, chart_id: product.id, chart_name: product.title %}
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                    <div class="mt-pdp__pills">
                      {%- for value in option.values -%}
                        <button class="mt-pdp__pill" type="button" data-pdp-value="{{ value | escape }}" data-pdp-opt="{{ forloop.parentloop.index0 }}" aria-pressed="{% if value.selected %}true{% else %}false{% endif %}">{{ value }}</button>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- assign promo_image = section.settings.promo_image -%}
          {%- assign promo_image_mobile = section.settings.promo_image_mobile -%}
          {%- assign promo_title = section.settings.promo_title -%}
          {%- assign promo_collections = section.settings.promo_collections -%}
          {%- assign promo_collection_handles = promo_collections | map: 'handle' -%}
          {%- assign promo_in_collection = true -%}
          {%- if promo_collections.size > 0 -%}
            {%- assign promo_in_collection = false -%}
            {%- for coll in product.collections -%}
              {%- if promo_collection_handles contains coll.handle -%}
                {%- assign promo_in_collection = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- assign show_promo = false -%}
          {%- if promo_in_collection -%}
            {%- if promo_image != blank -%}
              {%- assign show_promo = true -%}
            {%- elsif promo_title != blank -%}
              {%- assign show_promo = true -%}
            {%- endif -%}
          {%- endif -%}
          {%- if show_promo -%}
            <div class="mt-pdp__promo" data-reveal>
              {%- if promo_image != blank -%}
                {%- assign promo_alt = promo_image.alt | default: product.title | escape -%}
                {%- if promo_image_mobile != blank -%}
                  <picture>
                    <source media="(min-width: 750px)" srcset="{{ promo_image | image_url: width: 750 }} 750w, {{ promo_image | image_url: width: 1500 }} 1500w, {{ promo_image | image_url: width: 2200 }} 2200w">
                    {{ promo_image_mobile | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '100vw', alt: promo_alt, class: 'mt-pdp__promo-image' }}
                  </picture>
                {%- else -%}
                  {{ promo_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 40vw, 92vw', alt: promo_alt, class: 'mt-pdp__promo-image' }}
                {%- endif -%}
              {%- else -%}
                <div class="mt-pdp__promo-text">
                  {%- if section.settings.promo_subtitle != blank -%}
                    <p class="mt-pdp__promo-subtitle">{{ section.settings.promo_subtitle | newline_to_br }}</p>
                  {%- endif -%}
                  <p class="mt-pdp__promo-title">{{ promo_title | newline_to_br }}</p>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="mt-pdp__perks" data-reveal style="--mt-reveal-i: 2">
            {%- if section.settings.delivery_title != blank -%}
              {% render 'pdp-perk',
                icon: 'icon-delivery.svg',
                title: section.settings.delivery_title,
                copy: section.settings.delivery_copy,
                more: section.settings.delivery_text,
                panel_id: section.id,
                key: 'delivery'
              %}
            {%- endif -%}
            {%- if section.settings.returns_title != blank -%}
              {% render 'pdp-perk',
                icon: 'icon-returns.svg',
                title: section.settings.returns_title,
                copy: section.settings.returns_copy,
                more: section.settings.returns_text,
                panel_id: section.id,
                key: 'returns'
              %}
            {%- endif -%}
          </div>
        </div>

        {%- capture app_slot -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              <div class="mt-pdp__app" {{ block.shopify_attributes }}>{% render block %}</div>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if app_slot contains 'mt-pdp__app' -%}
          <div class="mt-pdp__apps">{{ app_slot }}</div>
        {%- endif -%}

        <div class="mt-pdp__ctas">
          <div class="mt-pdp__qty">
            <button class="mt-pdp__qty-btn" type="button" data-pdp-minus aria-label="{{ 'products.decrease_quantity' | t }}">&minus;</button>
            <span data-pdp-qty aria-live="polite">1</span>
            <button class="mt-pdp__qty-btn" type="button" data-pdp-plus aria-label="{{ 'products.increase_quantity' | t }}">+</button>
          </div>
          <button class="mt-pdp__add" type="button" data-pdp-add data-pdp-variant="{{ current.id }}"{% unless current.available %} disabled{% endunless %}>
            {%- if current.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif -%}
          </button>
        </div>
      </div>

      <div class="mt-pdp__lower">
        {%- assign statement = product.metafields.custom.statement.value -%}
        {%- if statement == blank -%}
          {%- assign statement = product.description | strip_html -%}
        {%- endif -%}
        {%- if statement != blank -%}
          <p class="mt-pdp__statement" data-reveal>{{ statement }}</p>
        {%- endif -%}

        {%- assign acc_blocks = section.blocks | where: 'type', 'item' -%}
        {%- if acc_blocks.size > 0 -%}
          <div class="mt-pdp__acc" data-reveal>
            {%- for block in acc_blocks -%}
              {%- assign body = block.settings.content -%}
              {%- if block.settings.use_description -%}
                {%- assign body = product.description -%}
              {%- endif -%}
              {%- if block.settings.title != blank and body != blank -%}
                <div class="mt-pdp__acc-item" {{ block.shopify_attributes }}>
                  <button class="mt-pdp__acc-head" type="button" data-pdp-toggle data-content-name="{{ block.settings.title | escape }}" aria-expanded="false" aria-controls="PdpAcc-{{ block.id }}">
                    <span>{{ block.settings.title }}</span>
                    <img src="{{ 'plus.svg' | asset_url }}" width="12" height="12" alt="" aria-hidden="true">
                  </button>
                  <div class="mt-pdp__acc-panel" id="PdpAcc-{{ block.id }}">
                    <div class="mt-pdp__acc-body">{{ body }}</div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign show_pairs = section.settings.show_pairs -%}
        {%- if product.metafields.custom.hide_pairs.value == true -%}
          {%- assign show_pairs = false -%}
        {%- endif -%}
        {%- if show_pairs -%}
          <div class="mt-pdp__pairs" data-pdp-pairs data-url="{{ routes.product_recommendations_url }}?section_id=product-pairs&product_id={{ product.id }}&limit=2&intent=complementary" hidden>
            <h2 class="mt-pdp__pairs-title">{{ section.settings.pairs_heading }}</h2>
            <div data-pdp-pairs-items></div>
            {%- assign pairs_source = product.collections.first -%}
            {%- if pairs_source -%}
              <div data-pdp-pairs-fallback hidden>
                {%- assign pair_i = 0 -%}
                {%- for item in pairs_source.products limit: 5 -%}
                  {%- if item.id == product.id -%}{%- continue -%}{%- endif -%}
                  {% render 'pdp-pair', item: item, index: pair_i, item_list_id: 'pdp_pairs', item_list_name: section.settings.pairs_heading %}
                  {%- assign pair_i = pair_i | plus: 1 -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-pdp-variants>
    [{%- for variant in product.variants -%}{%- capture v_ga4_variant -%}{% render 'item-variant-ga4', item: variant %}{%- endcapture -%}{%- assign v_ga4_variant = v_ga4_variant | strip -%}{"id":{{ variant.id }},"available":{{ variant.available }},"options":{{ variant.options | json }},"sku":{{ variant.sku | json }},"price":{{ variant.price | money_without_trailing_zeros | json }},"compare":{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money_without_trailing_zeros | json }}{% else %}""{% endif %},"media":{{ variant.featured_media.position | default: 0 }},"priceValue":{{ variant.price | divided_by: 100.0 }},"discountValue":{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | divided_by: 100.0 }}{% else %}0{% endif %},"itemVariant":{{ v_ga4_variant | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  </script>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "text",
      "id": "delivery_title",
      "label": "Delivery title",
      "default": "Free & fast delivery"
    },
    {
      "type": "text",
      "id": "delivery_copy",
      "label": "Delivery copy",
      "default": "All orders are processed within 1-2 business days."
    },
    {
      "type": "richtext",
      "id": "delivery_text",
      "label": "Delivery details",
      "default": "<p>Orders are processed within 1-2 business days and shipped with tracking, so you can follow your parcel from our door to yours.</p>"
    },
    {
      "type": "text",
      "id": "returns_title",
      "label": "Returns title",
      "default": "30-day free returns"
    },
    {
      "type": "text",
      "id": "returns_copy",
      "label": "Returns copy",
      "default": "Shop with confidence with our 30-day free returns policy."
    },
    {
      "type": "richtext",
      "id": "returns_text",
      "label": "Returns details",
      "default": "<p>Anything not quite right can go back within 30 days of delivery, unworn and with its tags on. Reach out through the contact page and we will sort the rest.</p>"
    },
    {
      "type": "header",
      "content": "利益点展示"
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "利益点pc端图片",
      "info": "如果设置了图片，则不展示标题和副标题。"
    },
    {
      "type": "image_picker",
      "id": "promo_image_mobile",
      "label": "利益点移动端图片",
      "info": "可选。留空则移动端使用上方的桌面图。"
    },
    {
      "type": "textarea",
      "id": "promo_title",
      "label": "利益点标题",
      "info": "支持换行。当设置了利益点图片时会被忽略。"
    },
    {
      "type": "textarea",
      "id": "promo_subtitle",
      "label": "利益点副标题",
      "info": "当设置了利益点图片时会被忽略。"
    },
    {
      "type": "collection_list",
      "id": "promo_collections",
      "label": "需要展示利益点的商品集合",
      "info": "留空则所有商品都展示。"
    },
    {
      "type": "text",
      "id": "pairs_heading",
      "label": "Pairs heading",
      "default": "Pairs well with"
    },
    {
      "type": "checkbox",
      "id": "show_pairs",
      "label": "Show Pairs well with",
      "info": "Turn off per product with a custom.hide_pairs product metafield set to true.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "item",
      "name": "Accordion item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
