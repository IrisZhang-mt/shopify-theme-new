{{ 'featured-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-collection.js' | asset_url }}" type="module"></script>

{%- assign featured = section.settings.collection -%}
{%- assign limit = section.settings.count -%}
{%- assign card_sizes = '(min-width: 750px) 335px, 258px' -%}
{%- assign has_products = false -%}
{%- if featured.products.size > 0 -%}
  {%- assign has_products = true -%}
{%- endif -%}

{%- if has_products or featured == blank -%}
<section class="mt-fc mt-fc--{{ section.settings.layout }}" style="--mt-fc-cols: {{ section.settings.columns }}">
  {%- if section.settings.heading != blank or section.settings.cta_label != blank -%}
    <div class="mt-fc__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="mt-fc__title" data-reveal>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        {%- assign cta_url = section.settings.cta_url | default: featured.url -%}
        {%- if cta_url != blank -%}
          <a class="mt-fc__cta" href="{{ cta_url | escape }}" data-reveal style="--mt-reveal-i: 1">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.layout == 'row' -%}
    <div class="mt-fc__stage" data-row-stage>
      <div class="mt-fc__row"{% if section.settings.autoplay %} data-autoplay="30"{% endif %} data-wheel-lock>
        {%- if has_products -%}
          {%- for item in featured.products limit: limit -%}
            {% render 'product-card', product: item, index: forloop.index0, sizes: card_sizes, quick: section.settings.quick %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            {% render 'product-card', product: blank, index: forloop.index0 %}
          {%- endfor -%}
        {%- endif -%}
      </div>
      <button class="mt-row-nav mt-row-nav--prev" type="button" data-row-arrow="prev" aria-label="{{ 'general.previous' | t }}">
        <img src="{{ 'arrow.svg' | asset_url }}" width="18" height="12" alt="">
      </button>
      <button class="mt-row-nav mt-row-nav--next" type="button" data-row-arrow="next" aria-label="{{ 'general.next' | t }}">
        <img src="{{ 'arrow.svg' | asset_url }}" width="18" height="12" alt="">
      </button>
    </div>
  {%- else -%}
    <div class="mt-fc__grid" data-fc-grid>
      {%- if has_products -%}
        {%- for item in featured.products limit: limit -%}
          {% render 'product-card', product: item, index: forloop.index0, sizes: card_sizes, quick: section.settings.quick, align: true %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {% render 'product-card', product: blank, index: forloop.index0 %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "row", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "row"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Grid columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "quick",
      "label": "Show quick shop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Drift the carousel automatically",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link",
      "info": "Defaults to the chosen collection."
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
