{{ 'multicolumn.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 or section.settings.heading != blank -%}
<section class="mt-cols{% if section.settings.align == 'center' %} mt-cols--center{% endif %}{% unless section.settings.contained %} mt-cols--full{% endunless %}" style="--mt-cols-count: {{ section.settings.columns }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="mt-cols__heading mt-rise" data-reveal>{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="mt-cols__grid" data-reveal-stagger>
    {%- for block in section.blocks -%}
      <div class="mt-cols__item" data-reveal style="--mt-reveal-i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {%- assign pc_image = block.settings.image | default: block.settings.mob_image -%}
        {%- assign mob_image = block.settings.mob_image | default: block.settings.image -%}
        {%- if pc_image != blank -%}
          <div class="{% if block.settings.image_style == 'icon' %}mt-cols__icon{% else %}mt-cols__media{% endif %}">
            {%- assign image_alt = pc_image.alt | default: block.settings.title | escape -%}
            <picture>
              <source media="(min-width: 750px)" srcset="{% render 'image-srcset', image: pc_image, widths: '400,600,800' %}" sizes="25vw">
              {{ mob_image | image_url: width: 800 | image_tag: decoding: 'async', loading: 'lazy', sizes: '50vw', alt: image_alt }}
            </picture>
          </div>
        {%- endif -%}
        {%- if section.settings.show_number -%}
          <span class="mt-cols__number">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <h3 class="mt-cols__title">{{ block.settings.title }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="mt-cols__text">{{ block.settings.text }}</div>
        {%- endif -%}
        {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
          <a class="mt-cols__link" href="{{ block.settings.link_url }}">{{ block.settings.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Multicolumn",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_number",
      "label": "Show number",
      "info": "按卡片顺序自动生成 01、02、03…",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "contained",
      "label": "Limit max width",
      "info": "开启：限制最大宽度并两边留白；关闭：图片铺满屏幕宽度，文字保留左右留白",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "PC image",
          "info": "留空时使用 Mobile 图片"
        },
        {
          "type": "image_picker",
          "id": "mob_image",
          "label": "Mobile image",
          "info": "留空时使用 PC 图片"
        },
        {
          "type": "select",
          "id": "image_style",
          "label": "Image style",
          "options": [
            { "value": "full", "label": "Full width" },
            { "value": "icon", "label": "Icon" }
          ],
          "default": "full"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
