{{ 'page-banner.css' | asset_url | stylesheet_tag }}

<section class="mt-banner">
  <div class="mt-banner__media" data-mt-parallax>
    {%- if section.settings.image != blank -%}
      {%- assign image_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: decoding: 'async', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 50vw, 100vw', alt: image_alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="mt-banner__scrim" aria-hidden="true"></div>

  {%- if section.settings.heading != blank -%}
    <h1 class="mt-banner__heading" data-reveal>{{ section.settings.heading }}</h1>
  {%- endif -%}

  <div class="mt-banner__body">
    {%- if section.settings.text != blank -%}
      <p class="mt-banner__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="mt-banner__cta" href="{{ section.settings.cta_url | default: '#' }}">
        <span>{{ section.settings.cta_label }}</span>
      </a>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="mt-banner__stats">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="mt-banner__stat" data-placement="{{ block.settings.placement }}" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <p class="mt-banner__stat-label">{{ block.settings.label }}</p>
            {%- endif -%}
            {%- if block.settings.value != blank -%}
              <p class="mt-banner__stat-value">{{ block.settings.value }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Page banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join our team." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "moodytiger is a global children’s sports lifestyle brand, dedicated to products tailored to the needs of children — inspiring them to explore the world with freedom and joy."
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "See open roles" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Open roles" },
        { "type": "text", "id": "value", "label": "Value", "default": "7 positions" },
        {
          "type": "select",
          "id": "placement",
          "label": "Desktop placement",
          "info": "On mobile, all stats appear together over the image.",
          "options": [
            { "value": "panel", "label": "On the text panel" },
            { "value": "media", "label": "On the image" }
          ],
          "default": "panel"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Page banner",
      "blocks": [
        { "type": "stat", "settings": { "label": "Open roles", "value": "7 positions", "placement": "panel" } },
        { "type": "stat", "settings": { "label": "Locations", "value": "United States · Malaysia", "placement": "media" } }
      ]
    }
  ]
}
{% endschema %}
