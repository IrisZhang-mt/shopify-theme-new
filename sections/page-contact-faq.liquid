{{ 'page-contact-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'page-contact-faq.js' | asset_url }}" type="module"></script>

<section class="mt-contact-faq" data-contact-faq>
  <div class="mt-contact-faq__media" data-reveal>
    {%- if section.settings.image != blank -%}
      {%- assign image_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
      {{ section.settings.image | image_url: width: 1380 | image_tag: decoding: 'async', loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', alt: image_alt }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="mt-contact-faq__body">
    {%- if section.settings.heading != blank -%}
      <h2 class="mt-contact-faq__heading" data-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mt-contact-faq__list" data-reveal>
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' and block.settings.question != blank and block.settings.answer != blank -%}
            <div class="mt-contact-faq__item mt-contact-faq__item--open" data-contact-faq-item {{ block.shopify_attributes }}>
              <button class="mt-contact-faq__q" type="button" data-contact-faq-toggle aria-expanded="true" aria-controls="ContactFaq-{{ block.id }}">
                <span>{{ block.settings.question }}</span>
                <img src="{{ 'plus.svg' | asset_url }}" width="12" height="12" alt="" aria-hidden="true">
              </button>
              <div class="mt-contact-faq__panel" id="ContactFaq-{{ block.id }}" role="region">
                <div class="mt-contact-faq__a">{{ block.settings.answer }}</div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact FAQ",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact FAQ"
    }
  ]
}
{% endschema %}
