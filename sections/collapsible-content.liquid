{{ 'rte.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collapsible-content.js' | asset_url }}" type="module"></script>

{%- if section.blocks.size > 0 or section.settings.heading != blank -%}
  <section class="mt-collapse">
    <div class="mt-collapse__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="mt-collapse__heading mt-rise" data-reveal>{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.settings.title != blank -%}
          {%- assign open = false -%}
          {%- if section.settings.open_first and forloop.first -%}
            {%- assign open = true -%}
          {%- endif -%}
          <div
            class="mt-collapse__item{% if open %} mt-collapse__item--open{% endif %}"
            data-collapse-item
            data-reveal
            style="--mt-reveal-i: {{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <button
              class="mt-collapse__q"
              type="button"
              id="CollapseQ-{{ block.id }}"
              data-collapse-toggle
              aria-expanded="{% if open %}true{% else %}false{% endif %}"
              aria-controls="Collapse-{{ block.id }}"
            >
              <span>{{ block.settings.title }}</span>
              <img src="{{ 'plus.svg' | asset_url }}" width="12" height="12" alt="" aria-hidden="true">
            </button>
            <div class="mt-collapse__panel" id="Collapse-{{ block.id }}" role="region" aria-labelledby="CollapseQ-{{ block.id }}">
              <div class="mt-collapse__a mt-rte">{{ block.settings.text }}</div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collapsible content",
  "class": "section-collapsible",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first row by default",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Collapsible row"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collapsible content",
      "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }]
    }
  ]
}
{% endschema %}
