{%- if recommendations.performed -%}
  <div data-cart-recs-items>
    <div class="mt-cart__tiles" data-cart-tiles>
      {%- for product in recommendations.products limit: 8 -%}
        {% render 'cart-tile', item: product, index: forloop.index0 %}
      {%- endfor -%}
    </div>
    <div class="mt-cart__progress"><span data-cart-progress></span></div>
    <div class="mt-cart__cards">
      {%- for product in recommendations.products limit: 8 -%}
        {% render 'product-card', product: product, quick: true, index: forloop.index0, sizes: '170px' %}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cart recommendations",
  "settings": []
}
{% endschema %}
