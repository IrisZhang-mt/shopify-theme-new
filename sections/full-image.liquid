{{ 'full-image.css' | asset_url | stylesheet_tag }}
<script src="{{ 'full-image.js' | asset_url }}" type="module"></script>

{%- assign pc_image = section.settings.pc_image -%}
{%- assign mob_image = section.settings.mob_image | default: pc_image -%}
{%- assign link = section.settings.link -%}
{%- assign heading = section.settings.heading -%}
{%- assign title = section.settings.title -%}
{%- assign subtitle = section.settings.subtitle -%}
{%- assign image_alt = pc_image.alt | default: mob_image.alt | default: '' | escape -%}
{%- assign ratio_mobile = mob_image.aspect_ratio | default: pc_image.aspect_ratio | default: 1 -%}
{%- assign ratio_desktop = pc_image.aspect_ratio | default: mob_image.aspect_ratio | default: 1 -%}
{%- if section.settings.eager_load -%}
  {%- assign img_loading = 'eager' -%}
  {%- assign img_fetchpriority = 'high' -%}
{%- else -%}
  {%- assign img_loading = 'lazy' -%}
  {%- assign img_fetchpriority = 'auto' -%}
{%- endif -%}
{%- if pc_image != blank -%}
  {%- capture pc_srcset -%}{% render 'image-srcset', image: pc_image, widths: '750,1100,1440,2200,2880' %}{%- endcapture -%}
{%- endif -%}
{%- if mob_image != blank -%}
  {%- capture mob_widths -%}{% render 'image-srcset', image: mob_image, widths: '375,550,750,1100,1500', output: 'widths' %}{%- endcapture -%}
  {%- capture mob_srcset -%}{% render 'image-srcset', image: mob_image, widths: '375,550,750,1100,1500' %}{%- endcapture -%}
{%- endif -%}

<section class="mt-full-image"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handleize }}"{% endif %}>
  {%- if heading != blank -%}
    <div class="mt-full-image__inner">
      <h2 class="mt-full-image__heading">{{ heading }}</h2>
    </div>
  {%- endif -%}

  <div class="mt-full-image__media" style="--mt-full-image-ratio: {{ ratio_mobile }}; --mt-full-image-ratio-desktop: {{ ratio_desktop }}">
    {%- if mob_image != blank -%}
      {%- if section.settings.eager_load -%}
        {%- if pc_image != blank -%}
          {{ mob_image | image_url: width: mob_image.width | preload_tag: as: 'image', media: '(max-width: 749.98px)', imagesrcset: mob_srcset, imagesizes: '100vw', fetchpriority: 'high' }}
          {{ pc_image | image_url: width: 1100 | preload_tag: as: 'image', media: '(min-width: 750px)', imagesrcset: pc_srcset, imagesizes: '100vw', fetchpriority: 'high' }}
        {%- else -%}
          {{ mob_image | image_url: width: mob_image.width | preload_tag: as: 'image', imagesrcset: mob_srcset, imagesizes: '100vw', fetchpriority: 'high' }}
        {%- endif -%}
      {%- endif -%}
      <picture>
        {%- if pc_image != blank -%}
          <source media="(min-width: 750px)" srcset="{{ pc_srcset }}" sizes="100vw">
        {%- endif -%}
        {{ mob_image | image_url: width: mob_image.width | image_tag: decoding: 'async', loading: img_loading, fetchpriority: img_fetchpriority, widths: mob_widths, sizes: '100vw', alt: image_alt }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- if title != blank or subtitle != blank -%}
      <div
        class="mt-full-image__content"
        style="--mt-full-image-title-color: {{ section.settings.title_color }}; --mt-full-image-subtitle-color: {{ section.settings.subtitle_color }}; --mt-full-image-title-leading: {{ section.settings.title_line_height }}%;
          {%- if section.settings.title_size_mobile != blank %} --mt-full-image-title-size-mob: {{ section.settings.title_size_mobile }}px;{% endif -%}
          {%- if section.settings.title_size_desktop != blank %} --mt-full-image-title-size-pc: {{ section.settings.title_size_desktop }}px;{% endif -%}
          {%- if section.settings.subtitle_size_mobile != blank %} --mt-full-image-subtitle-size-mob: {{ section.settings.subtitle_size_mobile }}px;{% endif -%}
          {%- if section.settings.subtitle_size_desktop != blank %} --mt-full-image-subtitle-size-pc: {{ section.settings.subtitle_size_desktop }}px;{% endif -%}
        "
      >
        {%- if title != blank -%}
          <h2
            class="mt-full-image__title"
            style="--mt-full-image-x-mob: {{ section.settings.title_x_mobile }}; --mt-full-image-y-mob: {{ section.settings.title_y_mobile }}; --mt-full-image-x-pc: {{ section.settings.title_x_desktop }}; --mt-full-image-y-pc: {{ section.settings.title_y_desktop }}; text-align: {{ section.settings.title_align }}"
          >
            {{- title | newline_to_br -}}
          </h2>
        {%- endif -%}
        {%- if subtitle != blank -%}
          <p
            class="mt-full-image__subtitle"
            style="--mt-full-image-x-mob: {{ section.settings.subtitle_x_mobile }}; --mt-full-image-y-mob: {{ section.settings.subtitle_y_mobile }}; --mt-full-image-x-pc: {{ section.settings.subtitle_x_desktop }}; --mt-full-image-y-pc: {{ section.settings.subtitle_y_desktop }}; text-align: {{ section.settings.subtitle_align }}"
          >
            {{- subtitle | newline_to_br -}}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if link != blank -%}
      <a
        class="mt-full-image__link"
        href="{{ link }}"
        aria-label="{{ image_alt }}"
        data-ga4-click="community_entry"
        data-ga4-button-name="image"
        data-ga4-button-link="{{ link | escape }}"
      ></a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Full image",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "留空时不展示"
    },
    {
      "type": "checkbox",
      "id": "eager_load",
      "label": "Load eagerly",
      "info": "在首屏的时候打开此开关；不是首屏时请保持关闭",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "pc_image",
      "label": "PC image"
    },
    {
      "type": "image_picker",
      "id": "mob_image",
      "label": "Mobile image",
      "info": "留空时使用 PC 图片"
    },
    {
      "type": "header",
      "content": "Image text"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "info": "叠加在图片上；留空时不展示"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "info": "叠加在图片上；留空时不展示"
    },
    {
      "type": "header",
      "content": "Title position",
      "info": "X：0 靠左 / 50 居中 / 100 靠右；Y：0 靠上 / 50 居中 / 100 靠下"
    },
    {
      "type": "range",
      "id": "title_x_desktop",
      "label": "Title X (PC)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "title_y_desktop",
      "label": "Title Y (PC)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 80
    },
    {
      "type": "range",
      "id": "title_x_mobile",
      "label": "Title X (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "title_y_mobile",
      "label": "Title Y (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 80
    },
    {
      "type": "select",
      "id": "title_align",
      "label": "Title text alignment",
      "info": "标题换行时每行的对齐方式",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Subtitle position",
      "info": "X：0 靠左 / 50 居中 / 100 靠右；Y：0 靠上 / 50 居中 / 100 靠下"
    },
    {
      "type": "range",
      "id": "subtitle_x_desktop",
      "label": "Subtitle X (PC)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "subtitle_y_desktop",
      "label": "Subtitle Y (PC)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "subtitle_x_mobile",
      "label": "Subtitle X (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "subtitle_y_mobile",
      "label": "Subtitle Y (Mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "subtitle_align",
      "label": "Subtitle text alignment",
      "info": "副标题换行时每行的对齐方式",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#FFFFFF"
    },
    {
      "type": "number",
      "id": "title_size_desktop",
      "label": "Title font size (PC, px)",
      "info": "留空时使用默认字号"
    },
    {
      "type": "number",
      "id": "title_size_mobile",
      "label": "Title font size (Mobile, px)",
      "info": "留空时使用默认字号"
    },
    {
      "type": "range",
      "id": "title_line_height",
      "label": "Title line height",
      "min": 50,
      "max": 150,
      "step": 1,
      "unit": "%",
      "default": 87
    },
    {
      "type": "number",
      "id": "subtitle_size_desktop",
      "label": "Subtitle font size (PC, px)",
      "info": "留空时使用默认字号"
    },
    {
      "type": "number",
      "id": "subtitle_size_mobile",
      "label": "Subtitle font size (Mobile, px)",
      "info": "留空时使用默认字号"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID (optional)",
      "info": "供 Anchor tabs 跳转定位，例如 new-arrivals；需与 tab 的 Target ID 一致，同一页面内不要重复"
    }
  ],
  "presets": [
    {
      "name": "Full image"
    }
  ]
}
{% endschema %}
