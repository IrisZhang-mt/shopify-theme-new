{{ 'rte.css' | asset_url | stylesheet_tag }}
{{ 'page.css' | asset_url | stylesheet_tag }}

<section class="mt-page">
  <div class="mt-page__inner">
    {%- if section.settings.show_title -%}
      <h1 class="mt-page__title mt-rise" data-reveal>{{ page.title }}</h1>
    {%- endif -%}
    <div class="mt-rte" data-reveal>
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    }
  ]
}
{% endschema %}
