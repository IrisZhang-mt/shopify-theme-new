<script src="{{ 'header.js' | asset_url }}" type="module"></script>

{%- assign menu = section.settings.menu -%}

<header class="mt-header">
  <div class="mt-header__bar">
    <nav class="mt-header__nav">
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <details class="mt-header__mega">
            <summary class="mt-header__link" data-nav1="{{ link.title | escape }}" {% if link.url != blank and link.url != '#' %}data-url="{{ link.url }}"{% endif %}>{{ link.title }}</summary>
            <div class="mt-header__panel">
              <div class="mt-header__featured">
                {%- for child in link.links -%}
                  {%- if child.links.size == 0 -%}
                    <a href="{{ child.url }}" data-nav1="{{ link.title | escape }}" data-side="{{ child.title | escape }}">{{ child.title }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <div class="mt-header__groups">
                {%- for child in link.links -%}
                  {%- if child.links.size > 0 -%}
                    <div class="mt-header__group">
                      <a class="mt-header__group-title" href="{{ child.url }}" data-nav1="{{ link.title | escape }}" data-nav2="{{ child.title | escape }}">{{ child.title }}</a>
                      <div class="mt-header__group-links">
                        {%- for grandchild in child.links -%}
                          <a href="{{ grandchild.url }}" data-nav1="{{ link.title | escape }}" data-nav2="{{ child.title | escape }}" data-nav3="{{ grandchild.title | escape }}">{{ grandchild.title }}</a>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </details>
        {%- else -%}
          <a class="mt-header__link" href="{{ link.url }}" data-nav1="{{ link.title | escape }}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <a class="mt-header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 596 | image_tag: decoding: 'async', widths: '149, 298, 447, 596', sizes: '149px', width: 149, height: 26, alt: shop.name }}
      {%- endif -%}
    </a>

    <div class="mt-header__utils">
      {%- if section.settings.signup_text != blank -%}
        <div class="mt-header__signup-wrap">
          {%- if section.settings.signup_url != blank -%}
            <a class="mt-header__signup" href="{{ section.settings.signup_url }}" data-text="{{ section.settings.signup_text | escape }}" data-func="Sign up">{{ section.settings.signup_text }}<span class="mt-header__signup-glint" aria-hidden="true"><span class="mt-header__signup-glint-text">{{ section.settings.signup_text }}</span></span>{% render 'icon-account', class: 'mt-header__signup-icon' %}</a>
          {%- else -%}
            <button class="mt-header__signup" type="button" data-pop-open data-text="{{ section.settings.signup_text | escape }}" data-func="Sign up">{{ section.settings.signup_text }}<span class="mt-header__signup-glint" aria-hidden="true"><span class="mt-header__signup-glint-text">{{ section.settings.signup_text }}</span></span>{% render 'icon-account', class: 'mt-header__signup-icon' %}</button>
          {%- endif -%}
        </div>
      {%- endif -%}
      <a class="mt-header__search" href="{{ routes.search_url }}" data-search-open data-func="Search" aria-expanded="false" aria-controls="HeaderSearch" aria-label="{{ 'header.search' | t }}">
        <span class="mt-header__search-text">{{ 'header.search' | t }}</span>
        <svg class="mt-header__search-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M8.73293 16.3565C12.3295 16.3565 15.2452 13.4408 15.2452 9.84426C15.2452 6.24767 12.3295 3.33203 8.73293 3.33203C5.13634 3.33203 2.2207 6.24767 2.2207 9.84426C2.2207 13.4408 5.13634 16.3565 8.73293 16.3565Z" stroke="currentColor" stroke-width="1.31339" stroke-linejoin="round"/><path d="M13.415 14.5261L16.6655 17.7766" stroke="currentColor" stroke-width="1.31339" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="mt-header__cart" href="{{ routes.cart_url }}" data-cart-open data-func="Cart" aria-label="{{ 'cart.title' | t }}">
        <svg class="mt-header__cart-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M15.7727 6.25008H4.21889C3.72888 6.25008 3.33301 6.63799 3.33301 7.11254V14.439C3.33301 16.8182 5.31882 18.75 7.77788 18.75H12.2228C14.6728 18.75 16.6663 16.8182 16.6663 14.439V7.11254C16.6629 6.88059 16.5679 6.65948 16.402 6.49777C16.2362 6.33606 16.0131 6.24697 15.7817 6.25008H15.7727Z" stroke="currentColor" stroke-width="1.11111" stroke-miterlimit="10"/><path d="M5 8.75V5.29637C5.00958 4.22117 5.54044 3.1926 6.47695 2.4347C7.41346 1.67681 8.67975 1.25099 10 1.25C12.7471 1.25 15 3.07582 15 5.3298V8.75" stroke="currentColor" stroke-width="1.11111" stroke-miterlimit="10"/></svg>
        <span class="mt-header__cart-count"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>

      <details class="mt-header__drawer">
        <summary class="mt-header__burger" aria-label="{{ 'header.menu' | t }}" data-func="Menu"><svg class="mt-burger" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3.5 5.5H17.5" stroke="currentColor" stroke-linecap="round"/><path d="M3.5 9.5H17.5" stroke="currentColor" stroke-linecap="round"/><path d="M3.5 13.5H17.5" stroke="currentColor" stroke-linecap="round"/></svg></summary>
        <div class="mt-drawer">
          <div class="mt-drawer__links">
            {%- for link in menu.links -%}
              {%- if link.links.size > 0 -%}
                <details class="mt-drawer__item">
                  <summary data-nav1="{{ link.title | escape }}">
                    <span>{{ link.title }}</span>
                    <span class="mt-icon"><img class="mt-icon__plus" src="{{ 'plus.svg' | asset_url }}" width="12" height="12" alt=""><img class="mt-icon__x" src="{{ 'x.svg' | asset_url }}" width="9" height="9" alt=""></span>
                  </summary>
                  <div class="mt-drawer__sub">
                    <div class="mt-drawer__featured">
                      {%- if link.url != blank and link.url != '#' -%}
                        <a href="{{ link.url }}">{{ 'header.shop_all' | t: label: link.title }}</a>
                      {%- endif -%}
                      {%- for child in link.links -%}
                        {%- if child.links.size == 0 -%}
                          <a href="{{ child.url }}" data-nav1="{{ link.title | escape }}" data-side="{{ child.title | escape }}">{{ child.title }}</a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                    <div class="mt-drawer__accordions">
                      {%- for child in link.links -%}
                        {%- if child.links.size > 0 -%}
                          <details class="mt-drawer__acc">
                            <summary data-nav1="{{ link.title | escape }}" data-nav2="{{ child.title | escape }}">
                              <span>{{ child.title }}</span>
                              <span class="mt-icon"><img class="mt-icon__plus" src="{{ 'plus.svg' | asset_url }}" width="12" height="12" alt=""><img class="mt-icon__x" src="{{ 'x.svg' | asset_url }}" width="9" height="9" alt=""></span>
                            </summary>
                            <div class="mt-drawer__acc-links">
                              {%- for grandchild in child.links -%}
                                <a href="{{ grandchild.url }}" data-nav1="{{ link.title | escape }}" data-nav2="{{ child.title | escape }}" data-nav3="{{ grandchild.title | escape }}">{{ grandchild.title }}</a>
                              {%- endfor -%}
                            </div>
                          </details>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                </details>
              {%- else -%}
                <a class="mt-drawer__link" href="{{ link.url }}" data-nav1="{{ link.title | escape }}">{{ link.title }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </details>
    </div>
  </div>

  <div class="mt-header__srch" id="HeaderSearch" data-search data-search-url="{{ routes.search_url }}" data-search-currency="{{ cart.currency.iso_code }}" hidden>
    <form class="mt-header__srch-form" action="{{ routes.search_url }}" method="get" role="search">
      <input
        class="mt-header__srch-input"
        type="search"
        name="q"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="{{ 'header.search' | t }}"
        data-search-input
      >
      <input type="hidden" name="type" value="product">
      <span class="mt-header__srch-mirror" data-search-mirror aria-hidden="true"></span>
      <button class="mt-header__srch-all" type="submit" data-search-all hidden>{{ 'search.all_results' | t }}</button>
    </form>
    {%- assign popular = section.settings.popular_searches | split: ',' -%}
    {%- if popular.size > 0 -%}
      <div class="mt-header__srch-block" data-search-popular>
        <p class="mt-header__srch-label">{{ 'search.popular' | t }}</p>
        <div class="mt-header__srch-tags">
          {%- for term in popular -%}
            {%- assign term_clean = term | strip -%}
            {%- if term_clean != blank -%}
              <button class="mt-header__srch-tag" type="button" data-search-chip="{{ term_clean | escape }}">{{ term_clean }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    <div class="mt-header__srch-block" data-search-suggest hidden>
      <p class="mt-header__srch-label">{{ 'search.suggestions' | t }}</p>
      <div class="mt-header__srch-tags" data-search-suggest-items></div>
    </div>
    <div class="mt-header__srch-results" data-search-results hidden></div>
    <p class="mt-header__srch-empty" data-search-empty hidden>{{ 'search.no_results' | t }}</p>
  </div>

  <div class="mt-header__scrim"></div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "signup_text",
      "label": "Signup text",
      "default": "Sign up for 10% Off"
    },
    {
      "type": "url",
      "id": "signup_url",
      "label": "Signup link"
    },
    {
      "type": "text",
      "id": "popular_searches",
      "label": "Popular searches",
      "info": "Comma-separated",
      "default": "Leggings, T-shirts, Outerwear, Dresses"
    }
  ]
}
{% endschema %}
