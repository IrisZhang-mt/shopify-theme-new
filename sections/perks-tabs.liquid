{%- comment -%}
  Perks tabs — up to 3 tabs (image + title); picking one swaps the 4-cell perk grid
  below it. A tab with "Opens Spin & Win" ticked also opens the Spin & Win dialog
  (spin-wheel.liquid listens for [data-spin-open]; the dialog itself handles
  signed-out / spins left / no spins). Mobile (< 990px) follows the 375 artboards,
  desktop the 1440 artboards (see perks-tabs.css).
{%- endcomment -%}
{%- liquid
  assign tab_count = section.blocks.size
  assign active_index = section.settings.default_tab | plus: 0
  if active_index > tab_count
    assign active_index = tab_count
  endif
  if active_index < 1
    assign active_index = 1
  endif
  assign module_name = section.settings.heading | strip | default: 'Perks Tabs'
-%}

{{ 'perks-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'perks-tabs.js' | asset_url }}" defer></script>

{%- if tab_count > 0 -%}
  <section
    class="mt-perks"
    data-perks
    data-module-name="{{ module_name | escape }}"
    {% if customer %}data-logged-in{% endif %}
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="mt-perks__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="mt-perks__tabs" role="tablist">
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_active = false
          if forloop.index == active_index
            assign is_active = true
          endif
        -%}
        <button
          class="mt-perks__tab{% if is_active %} is-active{% endif %}"
          type="button"
          role="tab"
          id="PerksTab-{{ block.id }}"
          aria-controls="PerksPanel-{{ block.id }}"
          aria-selected="{{ is_active }}"
          tabindex="{% if is_active %}0{% else %}-1{% endif %}"
          data-perks-tab
          {% if block.settings.open_spin %}data-spin-open{% endif %}
          {{ block.shopify_attributes }}
        >
          <span class="mt-perks__visual">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 604
                | image_tag:
                  loading: 'lazy',
                  decoding: 'async',
                  widths: '200, 302, 453, 604',
                  sizes: '(min-width: 1440px) 151px, (min-width: 990px) 10.5vw, (min-width: 560px) 146px, 26vw',
                  alt: ''
              }}
            {%- endif -%}
          </span>
          <span class="mt-perks__title">
            {{- block.settings.title | strip | escape | newline_to_br | replace: '<br />', '<br class="mt-perks__br">' -}}
          </span>
        </button>
      {%- endfor -%}
    </div>

    {%- if tab_count > 1 -%}
      <div class="mt-perks__dots" aria-hidden="true">
        {%- for block in section.blocks -%}
          <span class="mt-perks__dot{% if forloop.index == active_index %} is-active{% endif %}" data-perks-dot></span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div
        class="mt-perks__panel"
        role="tabpanel"
        id="PerksPanel-{{ block.id }}"
        aria-labelledby="PerksTab-{{ block.id }}"
        data-perks-panel
        {% unless forloop.index == active_index %}hidden{% endunless %}
      >
        {%- for i in (1..4) -%}
          {%- liquid
            assign perk_title_key = 'perk_' | append: i | append: '_title'
            assign perk_text_key = 'perk_' | append: i | append: '_text'
            assign perk_title = block.settings[perk_title_key]
            assign perk_text = block.settings[perk_text_key]
          -%}
          <div class="mt-perks__cell">
            {%- if perk_title != blank -%}
              <p class="mt-perks__perk">{{ perk_title | escape }}</p>
            {%- endif -%}
            {%- if perk_text != blank -%}
              <p class="mt-perks__note">{{ perk_text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Perks tabs",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Black Friday Perks",
      "info": "同时作为 GA4 的 module_name"
    },
    {
      "type": "select",
      "id": "default_tab",
      "label": "Default tab",
      "options": [
        { "value": "1", "label": "Tab 1" },
        { "value": "2", "label": "Tab 2" },
        { "value": "3", "label": "Tab 3" }
      ],
      "default": "2",
      "info": "页面打开时默认选中的 tab（按下方 block 顺序）"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "比例 151:96，建议 604 × 384 px；未选中时组件自动加半透明蒙层"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title",
          "default": "Spin & Win",
          "info": "换行只在手机端生效（例如 Member↵Perks），电脑端显示为一行"
        },
        {
          "type": "checkbox",
          "id": "open_spin",
          "label": "Opens Spin & Win",
          "default": false,
          "info": "勾选后点击此 tab 会同时打开抽奖弹窗（页面需包含 Spin & Win section）"
        },
        {
          "type": "header",
          "content": "Perk 1"
        },
        {
          "type": "text",
          "id": "perk_1_title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "perk_1_text",
          "label": "Text"
        },
        {
          "type": "header",
          "content": "Perk 2"
        },
        {
          "type": "text",
          "id": "perk_2_title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "perk_2_text",
          "label": "Text"
        },
        {
          "type": "header",
          "content": "Perk 3"
        },
        {
          "type": "text",
          "id": "perk_3_title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "perk_3_text",
          "label": "Text"
        },
        {
          "type": "header",
          "content": "Perk 4"
        },
        {
          "type": "text",
          "id": "perk_4_title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "perk_4_text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perks tabs",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "title": "Member\nPerks",
            "perk_1_title": "2× 10% off",
            "perk_1_text": "Welcome codes, stackable",
            "perk_2_title": "200 points",
            "perk_2_text": "Free at sign-up",
            "perk_3_title": "Give 15%, Get 15%",
            "perk_3_text": "Refer a friend",
            "perk_4_title": "Tier discount",
            "perk_4_text": "Gold 5% · Platinum 10%"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Spin & Win",
            "open_spin": true,
            "perk_1_title": "1 Spin Per $150",
            "perk_1_text": "$300 = 2 spins  •  $450 = 3",
            "perk_2_title": "10%/ 15% Off",
            "perk_2_text": "Every spin wins  •  1 month",
            "perk_3_title": "Free Outfit",
            "perk_3_text": "Pick 2 of 18, ships with order",
            "perk_4_title": "Gift Card/ Jacket",
            "perk_4_text": "$25 / $50 cards  • Sherpa Jacket"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Gift Card\nBonus",
            "perk_1_title": "Buy $300, get $30",
            "perk_1_text": "Bonus gift card",
            "perk_2_title": "Buy $500, get $60",
            "perk_2_text": "Bonus gift card",
            "perk_3_title": "Buy $1000, get $150",
            "perk_3_text": "Bonus gift card",
            "perk_4_title": "Bonus cards",
            "perk_4_text": "Emailed from Dec 2"
          }
        }
      ]
    }
  ]
}
{% endschema %}
