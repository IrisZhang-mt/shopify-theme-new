    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Comfort that keeps up, so nothing gets in the way of play."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Overrides the image"
        },
        {
          "type": "text",
          "id": "info_heading",
          "label": "Info heading"
        },
        {
          "type": "text",
          "id": "info_text",
          "label": "Info text"
        }
      ]
    },
    {
      "type": "slide",
      "name": "Extra slide",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Overrides the image"
        },
        {
          "type": "url",
