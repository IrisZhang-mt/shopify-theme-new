{{ 'home-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home-hero.js' | asset_url }}" type="module"></script>

{%- assign panels = section.blocks | where: 'type', 'panel' -%}
{%- assign extra_slides = section.blocks | where: 'type', 'slide' -%}
{%- assign hero_banner_name = section.settings.heading | strip_newlines | escape -%}

<section class="mt-hero" data-hero data-hero-interval="{{ section.settings.slide_interval | default: 5 }}">
  <div class="mt-hero__slide mt-hero__slide--active" data-hero-slide data-banner-slot="1" data-banner-name="{{ hero_banner_name }}">
    {%- for block in panels -%}
      {%- assign pc_image = block.settings.pc_image | default: block.settings.mob_image -%}
      {%- assign mob_image = block.settings.mob_image | default: block.settings.pc_image -%}
      <div class="mt-hero__panel{% unless forloop.first %} mt-hero__panel--secondary{% endunless %}" {% unless forloop.first %}data-banner-slot="1b" data-banner-name="{{ hero_banner_name }}"{% endunless %} {{ block.shopify_attributes }}>
        <div class="mt-hero__media">
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: autoplay: true, muted: true, loop: true, controls: false, playsinline: true, preload: 'metadata' }}
          {%- elsif mob_image != blank -%}
            <picture>
              {%- if pc_image != blank -%}
                <source media="(min-width: 750px)" srcset="{{ pc_image | image_url: width: 2880 }}">
              {%- endif -%}
              {%- if forloop.first -%}
                {{ mob_image | image_url: width: 2880 | image_tag: decoding: 'async', loading: 'eager', fetchpriority: 'high', preload: true, sizes: '(min-width: 750px) 50vw, 100vw', alt: '' }}
              {%- else -%}
                {{ mob_image | image_url: width: 2880 | image_tag: decoding: 'async', loading: 'eager', sizes: '(min-width: 750px) 50vw, 100vw', alt: '' }}
              {%- endif -%}
            </picture>
          {%- endif -%}
        </div>

        {%- if block.settings.link != blank -%}
          <a class="mt-hero__panel-link" href="{{ block.settings.link }}" aria-label="{{ hero_banner_name }}" data-banner-slot="1" {% unless forloop.first %}data-mobile-banner-slot="1b"{% endunless %} data-banner-name="{{ hero_banner_name }}" data-button-name="{{ hero_banner_name }}"></a>
        {%- endif -%}

        {%- if forloop.first -%}
          <div class="mt-hero__content">
            {%- if section.settings.heading != blank -%}
              <h1 class="mt-hero__heading">
                {%- assign lines = section.settings.heading | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  <span class="mt-hero__line"><span style="--mt-i: {{ forloop.index0 }}">{{ line | strip }}</span></span>
                {%- endfor -%}
              </h1>
            {%- endif -%}
            {%- if section.settings.subtext != blank -%}
              <p class="mt-hero__sub">{{ section.settings.subtext }}</p>
            {%- endif -%}
            {%- if section.settings.cta_label != blank -%}
              <a class="mt-hero__cta" href="{{ section.settings.cta_url | default: '#' }}" data-banner-slot="1" data-banner-name="{{ hero_banner_name }}" data-button-name="{{ section.settings.cta_label | escape }}"><span>{{ section.settings.cta_label }}</span></a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if block.settings.info_heading != blank -%}
          <div class="mt-hero__info">
            <p class="mt-hero__info-title">{{ block.settings.info_heading }}</p>
            {%- if block.settings.info_text != blank -%}
              <p class="mt-hero__info-text">{{ block.settings.info_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- for block in extra_slides -%}
    {%- assign slide_banner_slot = forloop.index | plus: 1 -%}
    {%- assign slide_banner_name = block.settings.heading | default: section.settings.heading | strip_newlines | escape -%}
    <div class="mt-hero__slide mt-hero__slide--layer" data-hero-slide data-banner-slot="{{ slide_banner_slot }}" data-banner-name="{{ slide_banner_name }}" {{ block.shopify_attributes }}>
      {%- assign slide_pc_image = block.settings.pc_image | default: block.settings.mob_image -%}
      {%- assign slide_mob_image = block.settings.mob_image | default: block.settings.pc_image -%}
      <div class="mt-hero__panel mt-hero__panel--full">
        <div class="mt-hero__media">
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: autoplay: true, muted: true, loop: true, controls: false, playsinline: true, preload: 'metadata' }}
          {%- elsif slide_mob_image != blank -%}
            <picture>
              {%- if slide_pc_image != blank -%}
                <source media="(min-width: 750px)" srcset="{{ slide_pc_image | image_url: width: 2880 }}">
              {%- endif -%}
              {{ slide_mob_image | image_url: width: 2880 | image_tag: decoding: 'async', loading: 'lazy', sizes: '100vw', alt: '' }}
            </picture>
          {%- endif -%}
        </div>
        <div class="mt-hero__content">
          {%- if block.settings.heading != blank -%}
            <h2 class="mt-hero__heading">
              {%- assign lines = block.settings.heading | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                <span class="mt-hero__line"><span style="--mt-i: {{ forloop.index0 }}">{{ line | strip }}</span></span>
              {%- endfor -%}
            </h2>
          {%- endif -%}
          {%- if block.settings.subtext != blank -%}
            <p class="mt-hero__sub">{{ block.settings.subtext }}</p>
          {%- endif -%}
          {%- if block.settings.cta_label != blank -%}
            <a class="mt-hero__cta" href="{{ block.settings.cta_url | default: '#' }}" data-banner-slot="{{ slide_banner_slot }}" data-banner-name="{{ slide_banner_name }}" data-button-name="{{ block.settings.cta_label | escape }}"><span>{{ block.settings.cta_label }}</span></a>
          {%- endif -%}
        </div>
        {%- if block.settings.link != blank -%}
          <a class="mt-hero__slide-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.heading | default: section.settings.heading | strip_newlines | escape }}" data-banner-slot="{{ slide_banner_slot }}" data-banner-name="{{ slide_banner_name }}" data-button-name="{{ slide_banner_name }}"></a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}

  {%- if extra_slides.size > 0 -%}
    <div class="mt-hero__dots" aria-label="{{ 'general.slides' | t }}">
      {%- assign slide_total = extra_slides.size | plus: 1 -%}
      {%- for i in (1..slide_total) -%}
        <button class="mt-hero__dot" type="button" data-hero-dot aria-label="{{ 'general.slide_n' | t: number: forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in\nthe play."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Comfort that keeps up, so nothing gets in the way of play."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "slide_interval",
      "label": "Slide interval",
      "info": "Only applies when there's more than one slide",
      "min": 2,
      "max": 5,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "pc_image",
          "label": "PC image",
          "info": "建议上传960*1140比例的图片"
        },
        {
          "type": "image_picker",
          "id": "mob_image",
          "label": "Mobile image",
          "info": "建议上传1:2比例的图片"
        },
        {
          "type": "video",
          "id": "pc_video",
          "label": "PC video",
          "info": "建议上传960*1140比例的视频，会覆盖图片"
        },
        {
          "type": "video",
          "id": "mob_video",
          "label": "Mobile video",
          "info": "建议上传1:2比例的视频，会覆盖图片"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link",
          "info": "Makes the image clickable"
        },
        {
          "type": "text",
          "id": "info_heading",
          "label": "Info heading"
        },
        {
          "type": "text",
          "id": "info_text",
          "label": "Info text"
        }
      ]
    },
    {
      "type": "slide",
      "name": "Extra slide",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "pc_image",
          "label": "PC image",
          "info": "建议上传1920*1141比例的图片"
        },
        {
          "type": "image_picker",
          "id": "mob_image",
          "label": "Mobile image",
          "info": "建议上传1:2比例的图片"
        },
        {
          "type": "video",
          "id": "pc_video",
          "label": "PC video",
          "info": "建议上传1920*1141比例的视频，会覆盖图片"
        },
        {
          "type": "video",
          "id": "mob_video",
          "label": "Mobile video",
          "info": "建议上传1:2比例的视频，会覆盖图片"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link",
          "info": "Makes the whole slide clickable"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "info_heading": "Made To Move",
            "info_text": "Breathable, durable, quick-drying fabrics"
          }
        },
        {
          "type": "panel",
          "settings": {
            "info_heading": "Worldwide Shipping",
            "info_text": "Fast delivery to families around the world."
          }
        }
      ]
    }
  ]
}
{% endschema %}
