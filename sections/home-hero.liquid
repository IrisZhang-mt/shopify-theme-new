        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "info_heading": "Made To Move",
            "info_text": "Breathable, durable, quick-drying fabrics"
          }
        },
        {
          "type": "panel",
          "settings": {
            "info_heading": "Worldwide Shipping",
            "info_text": "Fast delivery to families around the world."
          }
        }
      ]
    }
  ]
}
{% endschema %}
