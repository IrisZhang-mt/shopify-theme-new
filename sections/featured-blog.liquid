{{ 'blog.css' | asset_url | stylesheet_tag }}
{{ 'featured-blog.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-blog.js' | asset_url }}" type="module"></script>

{%- liquid
  assign article_count = 0
  for block in section.blocks
    if block.settings.article != blank
      assign article_count = article_count | plus: 1
    endif
  endfor
-%}

{%- if article_count > 0 or request.design_mode -%}
<section class="mt-fb">
  {%- if section.settings.heading != blank or section.settings.cta_label != blank -%}
    <div class="mt-fb__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="mt-fb__title" data-reveal>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a class="mt-fb__cta" href="{{ section.settings.cta_url }}" data-reveal style="--mt-reveal-i: 1">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%}
    data-autoplay="0" keeps the row in motion.js for arrow tweens without auto-scrolling.
    data-at-start is server-rendered so the prev arrow is hidden from first paint; featured-blog.js keeps both edge flags in sync.
  {%- endcomment -%}
  <div class="mt-fb__stage" data-row-stage data-at-start>
    <div class="mt-fb__row" data-fb-row data-autoplay="0" data-wheel-lock>
      {%- assign shown = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.article == blank -%}{%- continue -%}{%- endif -%}
        {%- assign reveal_i = shown | at_most: 2 -%}
        <div class="mt-fb__item" {{ block.shopify_attributes }}>
          {%- render 'article-card', article: block.settings.article, column: reveal_i, date_only: true, sizes: '(min-width: 1440px) 442px, (min-width: 750px) 31vw, 78vw' -%}
        </div>
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
    {%- if article_count > 3 -%}
      <button class="mt-row-nav mt-row-nav--prev" type="button" data-row-arrow="prev" aria-label="{{ 'general.previous' | t }}">
        <img src="{{ 'arrow.svg' | asset_url }}" width="18" height="12" alt="">
      </button>
      <button class="mt-row-nav mt-row-nav--next" type="button" data-row-arrow="next" aria-label="{{ 'general.next' | t }}">
        <img src="{{ 'arrow.svg' | asset_url }}" width="18" height="12" alt="">
      </button>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Featured blog",
  "class": "section-featured-blog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the Journal"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "Read all stories"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link",
      "info": "The link is hidden until both label and link are set."
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Featured blog",
      "blocks": [
        { "type": "article" },
        { "type": "article" },
        { "type": "article" }
      ]
    }
  ]
}
{% endschema %}
