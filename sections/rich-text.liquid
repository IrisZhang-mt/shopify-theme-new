{{ 'rte.css' | asset_url | stylesheet_tag }}
{{ 'rich-text.css' | asset_url | stylesheet_tag }}

{%- assign qr_image = section.settings.qr_image -%}
{%- if section.settings.heading != blank or section.settings.text != blank or section.settings.cta_label != blank or qr_image != blank -%}
<section class="mt-richtext{% if section.settings.align == 'center' %} mt-richtext--center{% endif %}{% if qr_image != blank %} mt-richtext--qr{% endif %}"
  style="
    {%- if section.settings.heading_size_mobile != blank %} --mt-richtext-heading-size-mob: {{ section.settings.heading_size_mobile }}px;{% endif -%}
    {%- if section.settings.heading_size_desktop != blank %} --mt-richtext-heading-size-pc: {{ section.settings.heading_size_desktop }}px;{% endif -%}
    {%- if section.settings.text_size_mobile != blank %} --mt-richtext-text-size-mob: {{ section.settings.text_size_mobile }}px;{% endif -%}
    {%- if section.settings.text_size_desktop != blank %} --mt-richtext-text-size-pc: {{ section.settings.text_size_desktop }}px;{% endif -%}
  "
>
  <div class="mt-richtext__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="mt-richtext__heading mt-rise" data-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="mt-rte" data-reveal style="--mt-reveal-i: 1">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <a class="mt-richtext__cta" href="{{ section.settings.cta_url }}" data-reveal style="--mt-reveal-i: 2">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
  {%- if qr_image != blank -%}
    {%- assign qr_alt = qr_image.alt | default: section.settings.qr_caption | escape -%}
    <div class="mt-richtext__qr" data-reveal style="--mt-reveal-i: 1">
      {{ qr_image | image_url: width: 300 | image_tag: decoding: 'async', loading: 'lazy', sizes: '(min-width: 750px) 104px, 56px', alt: qr_alt }}
      {%- if section.settings.qr_caption != blank -%}
        <p class="mt-richtext__qr-caption">{{ section.settings.qr_caption | newline_to_br }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "number",
      "id": "heading_size_desktop",
      "label": "Heading font size (PC, px)",
      "info": "留空时默认 70px"
    },
    {
      "type": "number",
      "id": "heading_size_mobile",
      "label": "Heading font size (Mobile, px)",
      "info": "留空时默认 15px"
    },
    {
      "type": "number",
      "id": "text_size_desktop",
      "label": "Text font size (PC, px)",
      "info": "留空时默认 14px"
    },
    {
      "type": "number",
      "id": "text_size_mobile",
      "label": "Text font size (Mobile, px)",
      "info": "留空时默认 8px"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "QR code"
    },
    {
      "type": "image_picker",
      "id": "qr_image",
      "label": "QR code image",
      "info": "配置后二维码显示在右侧；留空时不展示"
    },
    {
      "type": "textarea",
      "id": "qr_caption",
      "label": "QR code caption",
      "info": "显示在二维码下方；留空时不展示"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
