{{ 'home-split.css' | asset_url | stylesheet_tag }}

<section class="mt-split">
  {%- for block in section.blocks -%}
    {%- assign tile_tag = 'div' -%}
    {%- if block.settings.url != blank -%}
      {%- assign tile_tag = 'a' -%}
    {%- endif -%}
    <{{ tile_tag }}
      class="mt-split__tile"
      {% if tile_tag == 'a' %}href="{{ block.settings.url }}"{% endif %}
      data-reveal
      style="--mt-reveal-i: {{ forloop.index0 }}"
      {{ block.shopify_attributes }}
    >
      <div class="mt-split__media">
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 2880 | image_tag: decoding: 'async', loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', alt: ''}}
        {%- endif -%}
      </div>
      {%- if block.settings.heading != blank -%}
        <h2 class="mt-split__heading">{{ block.settings.heading }}</h2>
      {%- endif -%}
      <span class="mt-split__plus"><img src="{{ 'plus.svg' | asset_url }}" width="14" height="14" alt=""></span>
    </{{ tile_tag }}>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Split screen",
  "class": "section-split",
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "For Girls"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split screen",
      "blocks": [
        {
          "type": "tile",
          "settings": { "heading": "For Girls" }
        },
        {
          "type": "tile",
          "settings": { "heading": "For Boys" }
        }
      ]
    }
  ]
}
{% endschema %}
