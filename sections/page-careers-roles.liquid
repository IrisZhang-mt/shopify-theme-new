{{ 'page-careers-roles.css' | asset_url | stylesheet_tag }}

<section class="mt-careers-roles">
  <div class="mt-careers-roles__inner{% if section.settings.subtext == blank %} mt-careers-roles__inner--no-sub{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="mt-careers-roles__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="mt-careers-roles__sub">{{ section.settings.subtext | newline_to_br }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mt-careers-roles__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'item' -%}
            <div class="mt-careers-roles__list-item" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="mt-careers-roles__list-title">
                  {%- if section.settings.show_icon -%}
                    <svg class="mt-careers-roles__list-icon" width="5" height="5" viewBox="0 0 5 5" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M2.5 5C3.88071 5 5 3.88071 5 2.5C5 1.11929 3.88071 0 2.5 0C1.11929 0 0 1.11929 0 2.5C0 3.88071 1.11929 5 2.5 5Z" fill="#F37434"/>
                    </svg>
                  {%- endif -%}
                  <span>{{ block.settings.title }}</span>
                </h3>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="mt-careers-roles__list-subtitle">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Careers roles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Give 15%, Get 15%."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "info": "Use a line break to control where the text wraps.",
      "default": "Give friends 15% off their first order, and\nget a 15% off coupon for every referral."
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show list item icon",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "We take responsibility for our impact."
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "A responsibly acting party of the textile supply chain."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Careers roles"
    }
  ]
}
{% endschema %}
