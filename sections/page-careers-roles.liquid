{{ 'page-careers-roles.css' | asset_url | stylesheet_tag }}

<section class="mt-careers-roles">
  <div class="mt-careers-roles__inner{% if section.settings.subtext == blank %} mt-careers-roles__inner--no-sub{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="mt-careers-roles__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="mt-careers-roles__sub">{{ section.settings.subtext | newline_to_br }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mt-careers-roles__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'item' -%}
            <div class="mt-careers-roles__list-item" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h3 class="mt-careers-roles__list-title">
                  <span>{{ block.settings.title }}</span>
                </h3>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="mt-careers-roles__list-subtitle">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
          {%- elsif block.type == 'title' -%}
            <div class="mt-careers-roles__group" {{ block.shopify_attributes }}>
              {%- if block.settings.state != blank -%}
                <span class="mt-careers-roles__group-state">{{ block.settings.state }}</span>
              {%- endif -%}
              {%- if block.settings.count != blank -%}
                <span class="mt-careers-roles__group-count">{{ block.settings.count }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Careers roles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Give 15%, Get 15%."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "info": "Use a line break to control where the text wraps.",
      "default": "Give friends 15% off their first order, and\nget a 15% off coupon for every referral."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "List item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "We take responsibility for our impact."
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "A responsibly acting party of the textile supply chain."
        }
      ]
    },
    {
      "type": "title",
      "name": "Group title",
      "settings": [
        {
          "type": "text",
          "id": "state",
          "label": "State",
          "default": "The United States"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Count",
          "default": "6 roles"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Careers roles"
    }
  ]
}
{% endschema %}
