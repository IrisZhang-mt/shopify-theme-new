<section class="mt-cart-page" data-cart-root data-url="{{ routes.cart_url }}?section_id={{ section.id }}" data-currency="{{ cart.currency.iso_code }}">
  <div data-cart-content>
    <h1 class="mt-cart-page__title">{{ 'cart.title' | t }} ({{ cart.item_count }})</h1>
    {% render 'cart-shipping-bar' %}
    {%- if cart.item_count == 0 -%}
      <div class="mt-cart__empty">
        <p>{{ 'cart.empty' | t }}</p>
      </div>
    {%- else -%}
      <script>
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event_parameters: null });
        window.dataLayer.push({
          event: 'ga4Event',
          event_name: 'view_cart',
          event_parameters: {
            module_name: 'Cart Page',
            currency: {{ cart.currency.iso_code | json }},
            value: {{ cart.total_price | divided_by: 100.0 }},
            item_list_id: 'cart_page',
            item_list_name: 'Cart Page',
            items: [
              {%- render 'cart-items-ga4', item_list_id: 'cart_page', item_list_name: 'Cart Page' -%}
            ]
          }
        });
      </script>
      {% render 'cart-lines', item_list_id: 'cart_page', item_list_name: 'Cart Page', module_name: 'Cart Page' %}
      <div class="mt-cart-page__bar">
        {%- assign cart_savings = cart.original_total_price | minus: cart.total_price -%}
        {%- if cart_savings > 0 -%}
          <div class="mt-cart__savings">
            <p class="mt-cart__savings-label">{{ 'cart.savings' | t }} <button class="mt-offers-open" type="button" data-offers-open aria-label="{{ 'cart.offers_open' | t }}"></button></p>
            <p class="mt-cart__savings-amount">-{{ cart_savings | money_without_trailing_zeros }}</p>
          </div>
        {%- endif -%}
        <p>{{ 'cart.taxes_note' | t }}</p>
        <a class="mt-cart__checkout" href="/checkout" data-checkout data-module-name="Cart Page"><span class="mt-cart__checkout-label">{{ 'cart.checkout' | t }} &ndash; {% if cart.original_total_price > cart.total_price %}<s class="mt-cart__checkout-compare">{{ cart.original_total_price | money_without_trailing_zeros }}</s> - {% endif %}<span class="mt-cart__checkout-price">{{ cart.total_price | money_without_trailing_zeros }}</span></span></a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
