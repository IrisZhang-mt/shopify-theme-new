{{ 'product-feature-groups.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign groups = product.metafields.custom.feature_groups.value
-%}

{%- if groups != blank -%}
  <section class="mt-feature-groups">
    {%- for group in groups -%}
      {%- liquid
        assign image_1_alt = group.image_1.value.alt | default: group.heading.value | default: product.title
        assign image_2_alt = group.image_2.value.alt | default: group.heading.value | default: product.title
      -%}
      <div class="mt-feature-groups__group">
        {%- if group.heading.value != blank -%}
          <h2 class="mt-feature-groups__heading">{{ group.heading.value }}</h2>
        {%- endif -%}

        <div class="mt-feature-groups__points mt-feature-groups__points--1">
          {%- for point in group.points_1.value -%}
            <div class="mt-feature-groups__point">
              {%- if point.title.value != blank -%}
                <p class="mt-feature-groups__point-title">{{ point.title.value }}</p>
              {%- endif -%}
              {%- if point.subtitle.value != blank -%}
                <p class="mt-feature-groups__point-subtitle">{{ point.subtitle.value }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="mt-feature-groups__points mt-feature-groups__points--2">
          {%- for point in group.points_2.value -%}
            <div class="mt-feature-groups__point">
              {%- if point.title.value != blank -%}
                <p class="mt-feature-groups__point-title">{{ point.title.value }}</p>
              {%- endif -%}
              {%- if point.subtitle.value != blank -%}
                <p class="mt-feature-groups__point-subtitle">{{ point.subtitle.value }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if group.image_1.value != blank -%}
          <div class="mt-feature-groups__image mt-feature-groups__image--1">
            {{ group.image_1.value | image_url: width: 872 | image_tag:
              width: 436,
              height: 527,
              sizes: '(min-width: 750px) 436px, calc(50vw - 23.69px)',
              loading: 'lazy',
              decoding: 'async',
              alt: image_1_alt
            }}
          </div>
        {%- endif -%}

        {%- if group.image_2.value != blank -%}
          <div class="mt-feature-groups__image mt-feature-groups__image--2">
            {{ group.image_2.value | image_url: width: 872 | image_tag:
              width: 436,
              height: 527,
              sizes: '(min-width: 750px) 436px, calc(50vw - 23.69px)',
              loading: 'lazy',
              decoding: 'async',
              alt: image_2_alt
            }}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product feature groups",
  "settings": []
}
{% endschema %}
