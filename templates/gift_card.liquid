{% layout none %}
<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ shop.name }} &ndash; {{ 'gift_card.title' | t }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- endif -%}
    <style>
      @font-face {
        font-family: 'FK Display';
        src: url('{{ 'fk-display-regular.woff2' | asset_url }}') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'FK Grotesk';
        src: url('{{ 'fk-grotesk-regular.woff2' | asset_url }}') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      :root {
        --mt-ink: #1d1d1d;
        --mt-paper: #fafbf9;
        --mt-surface: #f8f4ee;
        --mt-moss: #818a7d;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.875rem;
        font-family: 'FK Grotesk', sans-serif;
        letter-spacing: -0.03em;
        color: var(--mt-ink);
        background: var(--mt-paper);
      }
      .card {
        width: 100%;
        max-width: 25rem;
        display: flex;
        flex-direction: column;
        gap: 1.875rem;
        padding: 2.5rem 1.875rem;
        border-radius: 4px;
        background: var(--mt-surface);
        text-align: center;
      }
      .shop {
        margin: 0;
        font-family: 'FK Display', sans-serif;
        font-size: 1.25rem;
      }
      h1 {
        margin: 0;
        font-family: 'FK Display', sans-serif;
        font-weight: 400;
        font-size: 1.875rem;
        line-height: 1.1;
      }
      .balance {
        margin: 0;
        font-family: 'FK Display', sans-serif;
        font-size: 2.8125rem;
        line-height: 1;
      }
      .note {
        margin: 0;
        font-size: 0.875rem;
        line-height: 1.2;
        color: var(--mt-moss);
      }
      .code {
        padding: 0.9375rem;
        border: 1px dashed var(--mt-moss);
        border-radius: 2px;
        font-size: 1rem;
        letter-spacing: 0.1em;
      }
      .qr {
        display: flex;
        justify-content: center;
      }
      .actions {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
      }
      .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 3.125rem;
        border: 0;
        border-radius: 0;
        background: var(--mt-ink);
        color: var(--mt-paper);
        cursor: pointer;
        font: inherit;
        font-size: 0.875rem;
        text-decoration: none;
        letter-spacing: inherit;
      }
      .btn--ghost {
        background: transparent;
        border: 1px solid var(--mt-ink);
        color: var(--mt-ink);
      }
      .btn:focus-visible {
        outline: 2px solid var(--mt-ink);
        outline-offset: 2px;
      }
      @media print {
        .actions {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <main class="card">
      <p class="shop">{{ shop.name }}</p>
      <h1>{{ 'gift_card.title' | t }}</h1>
      <p class="balance">{{ gift_card.balance | money_without_trailing_zeros }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="note">{{ 'gift_card.expired' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        {%- assign expiry = gift_card.expires_on | date: '%B %e, %Y' -%}
        <p class="note">{{ 'gift_card.expires' | t: date: expiry }}</p>
      {%- endif -%}
      <div class="qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <p class="code">{{ gift_card.code | format_code }}</p>
      <p class="note">{{ 'gift_card.redeem_note' | t }}</p>
      <div class="actions">
        <a class="btn" href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_card.start_shopping' | t }}</a>
        <button class="btn btn--ghost" type="button" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
        {%- if gift_card.pass_url -%}
          <a class="btn btn--ghost" href="{{ gift_card.pass_url }}">{{ 'gift_card.apple_wallet' | t }}</a>
        {%- endif -%}
      </div>
    </main>
    <script src="{{ 'vendor/qr-code.js' | shopify_asset_url }}" defer></script>
    <script>
      window.addEventListener('DOMContentLoaded', function () {
        var qr = document.querySelector('.qr');
        if (qr && window.QRCode) {
          new window.QRCode(qr, {
            text: qr.dataset.identifier,
            width: 120,
            height: 120,
          });
        }
      });
    </script>
  </body>
</html>
