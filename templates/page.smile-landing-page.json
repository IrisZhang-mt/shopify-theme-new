    "product_faq_Mnbqbd": {
      "type": "product-faq",
      "blocks": {
        "question_7JmaGm": {
          "type": "question",
          "settings": {
            "question": "How do I join?",
            "answer": "<p>Our store team can sign you up at checkout, or you can <a href=\"/account\" title=\"moodytiger-account\">join at moodytiger.com</a>. Membership is free, and joining earns you 200 bonus points to start.<br/><br/></p>"
          }
        },
        "question_YxJhXU": {
          "type": "question",
          "settings": {
            "question": "How are tiers calculated?",
            "answer": "<p>By the amount you actually spend within one calendar year (1 January to 31 December): $150 for Silver, $500 for Gold, $900 for Platinum.</p>"
          }
        },
        "question_dikiiz": {
          "type": "question",
          "settings": {
            "question": "Do tiers expire?",
            "answer": "<p>General never expires. Once you reach a tier, you keep it for the rest of that calendar year plus the whole of the next one. Qualifying restarts every 1 January, so if the following year's spend does not reach the same threshold, your tier is adjusted at the year-end review.</p>"
          }
        },
        "question_hWMmYd": {
          "type": "question",
          "settings": {
            "question": "How do I earn points?",
            "answer": "<p>1 point for every $1 you spend, based on the amount actually paid — an item listed at $198 and bought for $158 earns 158 points. You also earn 200 points for joining, 50 for following us on Instagram or liking us on Facebook, 100 for sharing on Facebook, and 150 for writing a product review.</p>"
          }
        },
        "question_wBgDkf": {
          "type": "question",
          "settings": {
            "question": "How do I redeem points?",
            "answer": "<p>250 points for $5 off, 350 points for $7 off, 700 points for $14 off, 1,400 points for $28 off.</p>"
          }
        },
        "question_iPPCqW": {
          "type": "question",
          "settings": {
            "question": "Do points expire?",
            "answer": "<p>Points are valid for one year. If there is no earning and no redemption for a whole year, the entire balance expires at once. Individual points do not have their own expiry dates.</p>"
          }
        },
        "question_V3ytq8": {
          "type": "question",
          "settings": {
            "question": "What do I get for referring a friend?",
            "answer": "<p>Give 15% off, get 15% off. Your friend receives a 15% off coupon, and yours arrives once they place their first order.</p>"
          }
        },
        "question_i7mhQQ": {
          "type": "question",
          "settings": {
            "question": "What is the new member offer?",
            "answer": "<p>Two 10% off coupons, valid for one month from the date you receive them, applicable to all products and stackable with other offers.</p>"
          }
        },
        "question_bzRFjq": {
          "type": "question",
          "settings": {
            "question": "How does the member discount work?",
            "answer": "<p>Gold enjoys 5% off and Platinum 10% off, on full-price items only, applied automatically at checkout.</p>"
          }
        },
        "question_cBYx8i": {
          "type": "question",
          "settings": {
            "question": "Where can I check my tier, points and coupons?",
            "answer": "<p><a href=\"/account\" title=\"moodytiger-account\">Sign in</a> to your account at moodytiger.com to see your current tier, points balance and available coupons.</p>"
          }
        }
      },
