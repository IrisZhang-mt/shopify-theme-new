{%- comment -%}
  Opt-in params (default off, so existing callers are unchanged):
  sale_badge — after the metafield badges (e.g. NEW), add a discount badge such as
    "33% OFF" (it replaces the "(-33%)" next to the price). The percentage is the
    same one the price line uses; if only some variants are discounted, the
    largest variant discount is used instead.
  hide_swatches — skip rendering (and computing) the colour swatches.
{%- endcomment -%}
{%- if product != blank -%}
  {%- liquid
    assign sale_percent = 0
    if sale_badge
      if product.compare_at_price_min > product.price_min
        assign sale_percent = product.compare_at_price_min | minus: product.price_min | times: 100.0 | divided_by: product.compare_at_price_min | round
      else
        for v in product.variants
          if v.compare_at_price > v.price
            assign v_percent = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round
            if v_percent > sale_percent
              assign sale_percent = v_percent
            endif
          endif
        endfor
      endif
    endif
    assign badge_sale = false
    if sale_percent > 0
      assign badge_sale = true
    endif
  -%}
  {%- if item_list_id != blank -%}
    {%- assign ga4_pick = product.variants | where: 'available', true | first -%}
    {%- assign ga4_pick = ga4_pick | default: product.variants.first -%}
    {%- capture ga4_variant -%}{% render 'item-variant-ga4', item: ga4_pick %}{%- endcapture -%}
    {%- assign ga4_variant = ga4_variant | strip -%}
  {%- endif -%}
  <div
    class="mt-card{% if badge_sale %} mt-card--sale{% endif %}"
    data-reveal
    style="--mt-reveal-i: {{ index | default: 0 }}"
    {%- if quick %} data-quick-url="{{ product.url }}"{% endif %}
    {%- if item_list_id != blank %}
      data-item-list-id="{{ item_list_id }}"
      data-item-list-name="{{ item_list_name | escape }}"
      data-item-id="{{ ga4_pick.sku }}"
      data-item-name="{{ product.title | escape }}"
      data-item-brand="{{ product.vendor | escape }}"
      {% if product.type != blank %}data-item-category="{{ product.type | escape }}"{% endif %}
      {% if ga4_variant != blank %}data-item-variant="{{ ga4_variant | escape }}"{% endif %}
      data-item-price="{{ product.price_min | divided_by: 100.0 }}"
      data-item-discount="{% if product.compare_at_price_min > product.price_min %}{{ product.compare_at_price_min | minus: product.price_min | divided_by: 100.0 }}{% else %}0{% endif %}"
      data-item-index="{{ ga4_index | default: index | default: 0 | plus: 1 }}"
    {%- endif -%}
  >
    <a class="mt-card__link" href="{{ product.url }}" aria-label="{{ product.title | escape }}"></a>
    <div class="mt-card__media">
      {%- liquid
        assign badge_1 = product.metafields.custom.product_badges
        assign badge_2 = product.metafields.custom.product_badges2
      -%}
      {%- if badge_1 != blank or badge_2 != blank or badge_sale -%}
        <div class="mt-card__badges">
          {%- if badge_1 != blank -%}
            <span class="mt-card__badge">{{ badge_1.value }}</span>
          {%- endif -%}
          {%- if badge_2 != blank -%}
            <span class="mt-card__badge">{{ badge_2.value }}</span>
          {%- endif -%}
          {%- if badge_sale -%}
            <span class="mt-card__badge mt-card__badge--sale">{{ 'products.badge_sale' | t: percent: sale_percent }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if product.featured_image -%}
        {%- assign image_alt = product.featured_image.alt | default: product.title | escape -%}
        {%- assign image_sizes = sizes | default: '(min-width: 750px) 335px, 258px' -%}
        {%- if eager -%}
          {{ product.featured_image | image_url: width: 750 | image_tag: decoding: 'async', loading: 'eager', fetchpriority: 'high', widths: '180, 260, 360, 460, 540, 670, 750', sizes: image_sizes, alt: image_alt }}
        {%- else -%}
          {{ product.featured_image | image_url: width: 750 | image_tag: decoding: 'async', loading: 'lazy', widths: '180, 260, 360, 460, 540, 670, 750', sizes: image_sizes, alt: image_alt }}
        {%- endif -%}
      {%- endif -%}
      {%- if quick -%}
        <button class="mt-card__qs" type="button" data-qs-open>{{ 'products.quick_shop' | t }}</button>
      {%- endif -%}
    </div>
    <div class="mt-card__text">
      <p class="mt-card__title">{{ product.title }}</p>
      <p class="mt-card__price">
        {%- if product.compare_at_price_min > product.price_min -%}
          <s class="mt-card__compare">{{ product.compare_at_price_min | money_without_trailing_zeros }}</s>
        {%- endif -%}
        <span class="mt-card__now">
          {{- product.price_min | money_without_trailing_zeros }}
        </span>
        {%- if product.compare_at_price_min > product.price_min and sale_badge != true -%}
          {%- assign discount_percent = product.compare_at_price_min | minus: product.price_min | times: 100.0 | divided_by: product.compare_at_price_min | round -%}
          <span class="mt-card__discount">(-{{ discount_percent }}%)</span>
        {%- endif -%}
      </p>
      {%- assign color_option = product.options_with_values | where: 'name', 'Color' | first -%}
      {%- unless color_option -%}
        {%- assign color_option = product.options_with_values | where: 'name', 'Colour' | first -%}
      {%- endunless -%}
      {%- capture swatches -%}
        {%- if color_option and settings.show_products_swatches and hide_swatches != true -%}
          {%- assign custom_color_keys = '' -%}
          {%- assign custom_color_values = '' -%}
          {%- if settings.color_swatches != blank -%}
            {%- assign custom_color_lines = settings.color_swatches | newline_to_br | split: '<br />' -%}
            {%- for line in custom_color_lines -%}
              {%- assign custom_color_key = line | split: ':' | first | rstrip -%}
              {%- assign custom_color_value = line | split: ':' | last | lstrip -%}
              {%- assign custom_color_keys = custom_color_keys | append: ',' | append: custom_color_key -%}
              {%- assign custom_color_values = custom_color_values | append: ',' | append: custom_color_value -%}
            {%- endfor -%}
            {%- assign custom_color_keys = custom_color_keys | remove_first: ',' | strip_newlines | downcase | split: ',' -%}
            {%- assign custom_color_values = custom_color_values | remove_first: ',' | split: ',' -%}
          {%- endif -%}
          {%- for value in color_option.values limit: 12 -%}
            {%- liquid
              assign swatch_active = false
              assign swatch_href = ''
              assign swatch_src = ''
              for variant in product.variants
                if variant.title contains value
                  assign swatch_href = variant.url
                  if variant.featured_image
                    assign swatch_src = variant.featured_image | image_url: width: 750
                  endif
                  if variant.featured_image and product.featured_image and variant.featured_image.id == product.featured_image.id
                    assign swatch_active = true
                  endif
                endif
              endfor

            -%}
            {%- capture swatch_value -%}
              {%- render 'color-swatch', value: value, custom_color_keys: custom_color_keys, custom_color_values: custom_color_values -%}
            {%- endcapture -%}
            {%- assign swatch_value = swatch_value | strip_newlines -%}
            <span
              class="mt-card__swatch mt-swatch{% if swatch_active %} is-active{% endif %}"
              style="--mt-swatch: {{ swatch_value }}"
              {%- if swatch_href != blank %} data-swatch-href="{{ swatch_href }}"{% endif -%}
              {%- if swatch_src != blank %} data-swatch-src="{{ swatch_src }}"{% endif -%}
            ><span class="visually-hidden">{{ value }}</span></span>
          {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- if swatches contains 'mt-card__swatch' -%}
        <div class="mt-card__swatches">{{ swatches }}</div>
        {% comment %} <p class="mt-card__swatches-caption">{{ 'products.available_colors' | t: count: color_option.values.size }}</p> {% endcomment %}
      {%- elsif align -%}
        <div class="mt-card__swatches"></div>
      {%- endif -%}
    </div>
    {%- if quick -%}
      <button class="mt-card__quick" type="button" data-qs-open>{{ 'products.quick_shop' | t }}</button>
    {%- endif -%}
  </div>
{%- else -%}
  <div class="mt-card mt-card--ghost" data-reveal style="--mt-reveal-i: {{ index | default: 0 }}">
    <div class="mt-card__media"></div>
    <div class="mt-card__text">
      <p class="mt-card__title">{{ 'onboarding.product_title' | t }}</p>
      <p class="mt-card__price">{{ 'onboarding.product_price' | t }}</p>
    </div>
  </div>
{%- endif -%}
