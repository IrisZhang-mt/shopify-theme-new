{%- assign tier_config = shop.metafields.custom.tiered_discount.value -%}
{%- if tier_config != blank and tier_config.enabled and tier_config.tiers.size > 0 -%}
  {%- assign eligible_tag = tier_config.eligible_tag -%}
  {%- assign tiers = tier_config.tiers -%}
  {%- assign tier_total = tiers.size -%}
  {%- assign tier_qty = 0 -%}
  {%- for item in cart.items -%}
    {%- if eligible_tag == blank or item.product.tags contains eligible_tag -%}
      {%- assign tier_qty = tier_qty | plus: item.quantity -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign unlocked_count = 0 -%}
  {%- for tier in tiers -%}
    {%- if tier_qty >= tier.qty -%}
      {%- assign unlocked_count = unlocked_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign active_index = unlocked_count | minus: 1 -%}
  {%- unless unlocked_count >= tier_total -%}
    {%- assign next_tier = tiers[unlocked_count] -%}
    {%- assign tier_remaining = next_tier.qty | minus: tier_qty -%}
  {%- endunless -%}
  <div class="mt-cart__tier-bar">
    {%- if unlocked_count >= tier_total -%}
      <p class="mt-cart__tier-text">{{ 'cart.tier_progress_complete' | t }}</p>
    {%- else -%}
      <p class="mt-cart__tier-text">{{ 'cart.tier_progress_remaining' | t: count: tier_remaining, reward: next_tier.reward_label }}</p>
    {%- endif -%}
    <div class="mt-cart__tier-nodes">
      {%- for tier in tiers -%}
        {%- assign tier_index = forloop.index0 -%}
        {%- assign segment_floor = 0 -%}
        {%- unless tier_index == 0 -%}
          {%- assign segment_floor = tiers[tier_index | minus: 1].qty -%}
        {%- endunless -%}
        {%- assign segment_span = tier.qty | minus: segment_floor -%}
        {%- assign segment_progress = tier_qty | minus: segment_floor -%}
        {%- assign segment_pct = segment_progress | times: 100.0 | divided_by: segment_span | at_most: 100 | at_least: 0 -%}
        <span class="mt-cart__tier-segment"><span class="mt-cart__tier-segment-fill" style="width: {{ segment_pct }}%"></span></span>
        {%- case tier.qty -%}
          {%- when 1 -%}{%- assign tier_ordinal = '1st' -%}
          {%- when 2 -%}{%- assign tier_ordinal = '2nd' -%}
          {%- when 3 -%}{%- assign tier_ordinal = '3rd' -%}
          {%- else -%}{%- assign tier_ordinal = tier.qty | append: 'th' -%}
        {%- endcase -%}
        <div class="mt-cart__tier-node{% if tier_index == active_index %} mt-cart__tier-node--active{% endif %}">
          <span class="mt-cart__tier-badge">{{ tier.reward_label }}</span>
          <span class="mt-cart__tier-ordinal">{{ tier_ordinal }}</span>
        </div>
      {%- endfor -%}
      {%- if unlocked_count >= tier_total -%}
        {%- assign trailing_pct = 100 -%}
      {%- else -%}
        {%- assign trailing_pct = 0 -%}
      {%- endif -%}
      <span class="mt-cart__tier-segment"><span class="mt-cart__tier-segment-fill" style="width: {{ trailing_pct }}%"></span></span>
    </div>
  </div>
{%- endif -%}
