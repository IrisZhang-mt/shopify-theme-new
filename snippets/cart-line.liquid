{%- capture ga4_variant -%}{% render 'item-variant-ga4', item: item %}{%- endcapture -%}
{%- assign ga4_variant = ga4_variant | strip -%}
<div
  class="mt-cart__line{% if group == 'other' %} mt-cart__line--other{% endif %}"
  data-item-list-id="{{ item_list_id }}"
  data-item-list-name="{{ item_list_name | escape }}"
  data-module-name="{{ module_name | escape }}"
  data-item-id="{{ item.sku }}"
  data-item-name="{{ item.product.title | escape }}"
  data-item-brand="{{ item.product.vendor | escape }}"
  {% if item.product.type != blank %}data-item-category="{{ item.product.type | escape }}"{% endif %}
  data-item-price="{{ item.final_price | divided_by: 100.0 }}"
  data-item-line-discount="{{ item.total_discount | divided_by: 100.0 }}"
  data-item-quantity="{{ item.quantity }}"
  {% if ga4_variant != blank %}data-item-variant="{{ ga4_variant | escape }}"{% endif %}
  data-item-index="{{ line }}"
>
  <a class="mt-cart__media" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
    {%- if item.image -%}
      {{ item.image | image_url: width: 400 | image_tag: decoding: 'async', loading: 'lazy', sizes: '(min-width: 750px) 140px, 100px', alt: item.product.title | escape }}
    {%- endif -%}
  </a>
  <div class="mt-cart__text">
    <div class="mt-cart__info">
      <a class="mt-cart__name" href="{{ item.url }}">{{ item.product.title }}</a>
      {%- unless item.product.has_only_default_variant -%}
        {%- for option in item.options_with_values -%}
          <p class="mt-cart__opt">{{ option.name }}: {{ option.value }}</p>
        {%- endfor -%}
      {%- endunless -%}
      {%- comment -%}
        Compare-at markdown ("SALE"): display only — it's already baked into the price Shopify
        charges, so it's not a discount application and stays out of Savings / checkout totals.
      {%- endcomment -%}
      {%- assign compare_at_price = item.variant.compare_at_price | default: 0 -%}
      {%- assign markdown_line = 0 -%}
      {%- if compare_at_price > item.original_price -%}
        {%- assign markdown_line = compare_at_price | minus: item.original_price | times: item.quantity -%}
        {%- assign markdown_percent = compare_at_price | minus: item.original_price | times: 100.0 | divided_by: compare_at_price | round -%}
        {%- assign markdown_line_money = markdown_line | money_without_trailing_zeros -%}
      {%- endif -%}
      {%- if markdown_line > 0 or item.discounts != blank -%}
        <ul class="mt-cart__discounts" role="list">
          {%- if markdown_line > 0 -%}
            <li class="mt-cart__discount">
              <span>{{ 'cart.markdown' | t: percent: markdown_percent, amount: '__AMOUNT__' | replace: '__AMOUNT__', markdown_line_money }}</span>
              <button class="mt-offers-open" type="button" data-offers-open aria-label="{{ 'cart.offers_open' | t }}"></button>
            </li>
          {%- endif -%}
          {%- for discount in item.discounts -%}
            <li class="mt-cart__discount">
              <span>{{ discount.title }} (-{{ discount.amount | money_without_trailing_zeros }})</span>
              <button class="mt-offers-open" type="button" data-offers-open aria-label="{{ 'cart.offers_open' | t }}"></button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="mt-cart__qty">
      <button class="mt-cart__qty-btn" type="button" data-cart-minus data-line="{{ line }}" aria-label="{{ 'products.decrease_quantity' | t }}"{% if item.quantity == 1 %} disabled{% endif %}>&minus;</button>
      <span data-cart-qty aria-live="polite">{{ item.quantity }}</span>
      <button class="mt-cart__qty-btn" type="button" data-cart-plus data-line="{{ line }}" aria-label="{{ 'products.increase_quantity' | t }}">+</button>
    </div>
  </div>
  <div class="mt-cart__side">
    <p class="mt-cart__price">
      {%- assign strike_line_price = item.original_line_price | plus: markdown_line -%}
      {%- if strike_line_price > item.final_line_price -%}
        <s class="mt-cart__compare">{{ strike_line_price | money_without_trailing_zeros }}</s>
      {%- endif %}
      {{ item.final_line_price | money_without_trailing_zeros }}
    </p>
    <button class="mt-cart__remove" type="button" data-cart-remove data-line="{{ line }}">{{ 'cart.remove' | t }}</button>
  </div>
</div>
