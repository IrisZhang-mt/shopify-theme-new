{%- capture ga4_variant -%}{% render 'item-variant-ga4', item: item %}{%- endcapture -%}
{%- assign ga4_variant = ga4_variant | strip -%}
<div
  class="mt-cart__line"
  data-item-list-id="{{ item_list_id }}"
  data-item-list-name="{{ item_list_name | escape }}"
  data-module-name="{{ module_name | escape }}"
  data-item-id="{{ item.sku }}"
  data-item-name="{{ item.product.title | escape }}"
  data-item-brand="{{ item.product.vendor | escape }}"
  {% if item.product.type != blank %}data-item-category="{{ item.product.type | escape }}"{% endif %}
  data-item-price="{{ item.final_price | divided_by: 100.0 }}"
  {% if ga4_variant != blank %}data-item-variant="{{ ga4_variant | escape }}"{% endif %}
  data-item-index="{{ line }}"
>
  <a class="mt-cart__media" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
    {%- if item.image -%}
      {{ item.image | image_url: width: 400 | image_tag: decoding: 'async', loading: 'lazy', sizes: '(min-width: 750px) 140px, 100px', alt: item.product.title | escape }}
    {%- endif -%}
  </a>
  <div class="mt-cart__text">
    <div class="mt-cart__info">
      <a class="mt-cart__name" href="{{ item.url }}">{{ item.product.title }}</a>
      {%- unless item.product.has_only_default_variant -%}
        {%- for option in item.options_with_values -%}
          <p class="mt-cart__opt">{{ option.name }}: {{ option.value }}</p>
        {%- endfor -%}
      {%- endunless -%}
    </div>
    <div class="mt-cart__qty">
      <button class="mt-cart__qty-btn" type="button" data-cart-minus data-line="{{ line }}" aria-label="{{ 'products.decrease_quantity' | t }}"{% if item.quantity == 1 %} disabled{% endif %}>&minus;</button>
      <span data-cart-qty aria-live="polite">{{ item.quantity }}</span>
      <button class="mt-cart__qty-btn" type="button" data-cart-plus data-line="{{ line }}" aria-label="{{ 'products.increase_quantity' | t }}">+</button>
    </div>
  </div>
  <div class="mt-cart__side">
    <!-- DEBUG START: remove before commit -->
    <p style="color:red;font-size:10px;line-height:1.4;text-align:right;">
      variant.compare_at_price={{ item.variant.compare_at_price }}<br>
      variant.price={{ item.variant.price }}<br>
      original_price={{ item.original_price }}<br>
      final_price={{ item.final_price }}<br>
      original_line_price={{ item.original_line_price }}<br>
      final_line_price={{ item.final_line_price }}
    </p>
    <!-- DEBUG END -->
    {%- if item.variant.compare_at_price > item.variant.price -%}
      <s class="mt-cart__compare">{{ item.variant.compare_at_price | times: item.quantity | money_without_trailing_zeros }}</s>
    {%- endif -%}
    <p class="mt-cart__price">{{ item.final_line_price | money_without_trailing_zeros }}</p>
    <button class="mt-cart__remove" type="button" data-cart-remove data-line="{{ line }}">{{ 'cart.remove' | t }}</button>
  </div>
</div>
