{% doc %}
  Resolves the swatch color/image for a single color option value. Shared by every
  module that renders color swatches (PDP, product card, quick shop, PDP pairs) so
  the fallback priority stays identical everywhere.

  Priority: product color_swatch metafield image, metaobject color_swatch image,
  native Shopify swatch (color then image), metaobject color_swatch color, product
  color_swatch metafield color, settings.color_swatches text mapping.

  @param {string} value - The option value (an entry from option.values).
  @param {number} index - value's position in option.values (forloop.index0), used
    to read the parallel swatch_colors/swatch_images arrays.
  @param {object} [swatch_colors] - product.metafields.custom.color_swatch mapped to 'color'.
  @param {object} [swatch_images] - product.metafields.custom.color_swatch mapped to 'image'.
  @param {object} [custom_color_keys] - Downcased keys parsed from settings.color_swatches.
  @param {object} [custom_color_values] - Values parsed from settings.color_swatches, same order as custom_color_keys.
  @param {number} [image_width] - Width to request for swatch images. Defaults to 30.

  @example
  {%- capture swatch_value -%}
    {%- render 'color-swatch', value: value, index: forloop.index0, swatch_colors: swatch_colors, swatch_images: swatch_images, custom_color_keys: custom_color_keys, custom_color_values: custom_color_values -%}
  {%- endcapture -%}
  <button style="--mt-swatch: {{ swatch_value | strip_newlines }}"></button>
{% enddoc %}
{%- liquid
  assign image_width = image_width | default: 30
  assign swatch_handle = value | handleize
  assign swatch_entry = shop.metaobjects.color_swatch[swatch_handle]
  assign custom_color_lookup = value | downcase | escape
  assign custom_color_value = ''
  for key in custom_color_keys
    if key == custom_color_lookup
      assign custom_color_value = custom_color_values[forloop.index0]
    endif
  endfor

  assign swatch_value = ''
  if swatch_images[index]
    assign swatch_value = swatch_images[index] | image_url: width: image_width | prepend: "url('" | append: "')"
  elsif swatch_entry.image
    assign swatch_value = swatch_entry.image | image_url: width: image_width | prepend: "url('" | append: "')"
  elsif value.swatch.color
    assign swatch_value = value.swatch.color.rgb | prepend: 'rgb(' | append: ')'
  elsif value.swatch.image
    assign swatch_value = value.swatch.image | image_url: width: image_width | prepend: "url('" | append: "')"
  elsif swatch_entry.color
    assign swatch_value = swatch_entry.color
  elsif swatch_colors[index]
    assign swatch_value = swatch_colors[index]
  elsif custom_color_value contains '.'
    assign swatch_value = custom_color_value | file_url | prepend: "url('" | append: "')"
  elsif custom_color_value != blank
    assign swatch_value = custom_color_value
  endif
-%}{{- swatch_value -}}
