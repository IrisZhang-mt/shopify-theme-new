{%- comment -%}
  Resolves the swatch color/image for a single color option value. Shared by every
  module that renders color swatches (PDP, product card, quick shop, PDP pairs) so
  the fallback priority stays identical everywhere.

  Priority: native Shopify swatch (color then image), metaobject color_swatch color,
  settings.color_swatches text mapping, then a guessed "<value | handleize>.png"
  from Settings > Files over an off-white fallback.

  Params: value (the option value), custom_color_keys/custom_color_values (parsed
  from settings.color_swatches), image_width (defaults to 30).
{%- endcomment -%}
{%- liquid
  assign image_width = image_width | default: 30
  assign swatch_handle = value | handleize
  assign swatch_entry = shop.metaobjects.color_swatch[swatch_handle]
  assign custom_color_lookup = value | downcase | escape
  assign custom_color_value = ''
  for key in custom_color_keys
    if key == custom_color_lookup
      assign custom_color_value = custom_color_values[forloop.index0]
    endif
  endfor

  assign swatch_value = ''
  if value.swatch.color
    assign swatch_value = value.swatch.color.rgb | prepend: 'rgb(' | append: ')'
  elsif value.swatch.image
    assign swatch_value = value.swatch.image | image_url: width: image_width | prepend: "url('" | append: "')"
  elsif swatch_entry.color
    assign swatch_value = swatch_entry.color
  elsif custom_color_value contains '.'
    assign swatch_value = custom_color_value | file_url | prepend: "url('" | append: "')"
  elsif custom_color_value != blank
    assign swatch_value = custom_color_value
  else
    # Unmapped: guess "<handle>.png" in Settings > Files; off-white shows through if it 404s
    assign swatch_value = swatch_handle | append: '.png' | file_url | prepend: "url('" | append: "') var(--mt-off-white)"
  endif
-%}{{- swatch_value -}}
