{%- comment -%}
  GA4 ecommerce items[] entries for the current cart (view_cart event).
  Params: item_list_id, item_list_name
{%- endcomment -%}
{%- for item in cart.items -%}
  {%- assign ga4_color = blank -%}
  {%- assign ga4_size = blank -%}
  {%- for option in item.options_with_values -%}
    {%- case option.name -%}
      {%- when 'Color' -%}
        {%- assign ga4_color = option.value -%}
      {%- when 'Size' -%}
        {%- assign ga4_size = option.value -%}
    {%- endcase -%}
  {%- endfor -%}
  {%- if ga4_color != blank and ga4_size != blank -%}
    {%- assign ga4_variant = ga4_color | append: '_' | append: ga4_size -%}
  {%- elsif ga4_color != blank -%}
    {%- assign ga4_variant = ga4_color -%}
  {%- elsif ga4_size != blank -%}
    {%- assign ga4_variant = ga4_size -%}
  {%- else -%}
    {%- assign ga4_variant = blank -%}
  {%- endif -%}
  {
    "item_list_id": {{ item_list_id | json }},
    "item_list_name": {{ item_list_name | json }},
    "item_id": {{ item.sku | json }},
    "item_name": {{ item.product.title | json }},
    "index": {{ forloop.index }},
    {%- if ga4_variant != blank -%}
    "item_variant": {{ ga4_variant | json }},
    {%- endif -%}
    "item_brand": {{ item.product.vendor | json }},
    "discount": {{ item.total_discount | divided_by: 100.0 }},
    "price": {{ item.final_price | divided_by: 100.0 }},
    "quantity": {{ item.quantity }}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
