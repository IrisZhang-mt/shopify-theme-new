<a class="mt-blog__card" href="{{ article.url }}" data-reveal style="--mt-reveal-i: {{ column }}">
  <div class="mt-blog__media">
    {%- if article.image -%}
      {%- assign image_alt = article.image.alt | default: article.title | escape -%}
      {{ article.image | image_url: width: 1000 | image_tag: decoding: 'async', loading: 'lazy', sizes: '(min-width: 750px) 31vw, 92vw', alt: image_alt }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <p class="mt-blog__meta">
    <span>{{ article.published_at | date: '%B %-d, %Y.' }}</span>
    <span class="mt-blog__sep" aria-hidden="true"></span>
    <span class="mt-blog__read">
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><circle cx="5" cy="5" r="4.25" stroke="currentColor"/><path d="M5 2.75V5l1.6 1.1" stroke="currentColor" stroke-linecap="round"/></svg>
      {%- assign words = article.content | strip_html | split: ' ' | size -%}
      {%- assign mins = words | divided_by: 200 | at_least: 1 -%}
      {{ 'blog.read_time' | t: count: mins }}
    </span>
    <span class="mt-blog__sep mt-blog__extra" aria-hidden="true"></span>
    <span class="mt-blog__extra">{{ article.published_at | date: '%d/%m/%Y' }}</span>
  </p>
  <p class="mt-blog__name">{{ article.title }}</p>
</a>
