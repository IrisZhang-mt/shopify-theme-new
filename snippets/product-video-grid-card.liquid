{%- comment -%}
  Renders one product-video-grid card. Outputs nothing when neither pc_file
  nor mb_file is set, so a group with text but no video stays hidden.
{%- endcomment -%}
{%- if pc_file != blank or mb_file != blank -%}
  {%- assign lines = text | newline_to_br | split: '<br />' -%}
  {%- assign card_title = lines[0] | strip -%}
  {%- assign card_subtitle = lines[1] | strip -%}
  <div class="mt-video-grid__card" data-video-grid-card>
    <div class="mt-video-grid__media">
      {%- if pc_file != blank and mb_file != blank -%}
        <video class="mt-video-grid__video mt-video-grid__video--pc" muted loop playsinline preload="none" src="{{ pc_file.url }}"></video>
        <video class="mt-video-grid__video mt-video-grid__video--mob" muted loop playsinline preload="none" src="{{ mb_file.url }}"></video>
      {%- else -%}
        {%- assign fallback_file = pc_file | default: mb_file -%}
        <video class="mt-video-grid__video" muted loop playsinline preload="none" src="{{ fallback_file.url }}"></video>
      {%- endif -%}
    </div>
    {%- if card_title != blank or card_subtitle != blank -%}
      <div class="mt-video-grid__caption">
        {%- if card_title != blank -%}<p class="mt-video-grid__title">{{ card_title }}</p>{%- endif -%}
        {%- if card_subtitle != blank -%}<p class="mt-video-grid__subtitle">{{ card_subtitle }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
